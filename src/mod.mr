// Kioto 3.0.0 — package entry point.
//
// A bare `load kioto` resolves to this file, so it is what makes the whole
// library visible to a consumer: each `load` below pulls in one [exports] entry
// from owl.toml. A broken export or an unresolvable path therefore fails loudly
// here, in the package itself, instead of surfacing as a missing function in
// someone else's build.
//
// The load list is the package's public surface. Keep it in sync with the
// [exports] table in owl.toml.
//
// Per-module notes:
//   - The 2.x layout under core/ is gone; everything now lives in modules/ with
//     the .mr extension.
//   - math is being rebuilt in 3.0 as a pure-Mire rewrite, one submodule at a
//     time. Root, consts, float, int, random, seq, stats and sum are done;
//     complex, decimal, hyperbolic, power, special and trig are still to come
//     and are not exported until they have real symbols behind them
//     (see modules/math/mod.mr).

@[no_main]
module kioto
load kioto::strings
load kioto::time
load kioto::fs
load kioto::env
load kioto::proc
load kioto::async
load kioto::mem
load kioto::cpu
load kioto::math
load kioto::net
load kioto::log
load kioto::cli
load kioto::crypto

// ── status() ──────────────────────────────────────────────────────────
// Returns a phpinfo-style console report of the library: name, version,
// build profile, runtime tier, exported modules, and configuration.
// Intended for `use dasu(kioto::status())` or direct `use kioto::status()`
// to inspect what a loaded library provides.
pub fn status: () :str {
    set report = "════════════════════════════════════════════════════════════════" :str mut
    set report = report + "\nLibrary:    kioto" + "\n"
    set report = report + "Version:    3.1.0" + "\n"
    set report = report + "Description: Kioto is the Avenys/mire standard library" + "\n"
    set report = report + "Runtime:    Mire / Avenys (minimal tier)" + "\n"
    set report = report + "Exports:    strings, time, fs, env, proc, async, mem, cpu, math, net, log, cli, crypto" + "\n"
    set report = report + "Status:     active" + "\n"
    set report = report + "════════════════════════════════════════════════════════════════" + "\n"
    return report
}
