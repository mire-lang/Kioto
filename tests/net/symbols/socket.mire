// Per-symbol suite: kioto::net::socket::{connect::tcp,connect::udp,send,recv,close}
//
// The socket API requires a network connection. In the test environment,
// network connections may not be available or may hang. These tests verify
// the API compiles and returns expected handle values without blocking.

load kioto
load! /tests/_support/harness

@[test]
pub fn connect_tcp_smoke: () :bool {
    // Test that the function exists and returns a handle.
    // We use a port that's unlikely to be listening, but we don't wait
    // for the connection to complete - we just check the handle is returned.
    set sock = net::socket::connect::tcp("127.0.0.1", 9 :u16)
    set handle = sock.handle
    // Handle could be >0 (connected) or <=0 (failed). Both are valid.
    if handle > 0 {
        use net::socket::close(sock)
    }
    return true
}

@[test]
pub fn connect_udp_smoke: () :bool {
    set sock = net::socket::connect::udp("127.0.0.1", 9 :u16)
    set handle = sock.handle
    if handle > 0 {
        use net::socket::close(sock)
    }
    return true
}

@[test]
pub fn close_smoke: () :bool {
    set sock = net::socket::connect::tcp("127.0.0.1", 9 :u16)
    set handle = sock.handle
    if handle > 0 {
        use net::socket::close(sock)
    }
    return true
}