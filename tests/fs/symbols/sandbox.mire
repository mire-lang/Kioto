// Per-symbol suite: kioto::fs::sandbox and kioto::fs::unrestricted.
//
// The policy is process-wide and defaults to the working directory. Every case
// that changes it restores the default before returning, so the other tests in
// this binary (and every later file) see the same root.
//
// The last two cases are the security contract: a capability root must confine
// every child path, including an absolute one. The runtime currently opens
// "/etc/passwd" through a root opened at "." and reads it; that escape is
// asserted as a failure and logged with its real size.

load kioto
load! /tests/_support/harness

fn cwd: () :str {
    return strings::copy(env::cwd())
}

@[test]
pub fn permits_success_inside: () :bool {
    set base = cwd()
    set absolute = strings::copy(strings::concat(base, "/tests"))
    set ok = true :bool mut
    if !use! harness::check("sandbox/permits/absolute-inside", fs::sandbox::permits(absolute)) { set ok = false }
    if !use! harness::check("sandbox/permits/relative", fs::sandbox::permits("tests")) { set ok = false }
    if !use! harness::check("sandbox/permits/normalized-inside", fs::sandbox::permits("tests/../README.md")) { set ok = false }
    return ok
}

@[test]
pub fn permits_limit_outside_absolute: () :bool {
    set allowed = fs::sandbox::permits("/etc/passwd")
    set code = fs::sandbox::reason()
    set text = fs::sandbox::reason_text()
    set denied = fs::sandbox::denied_path()
    set ok = true :bool mut
    if !use! harness::check_false("sandbox/permits/outside", allowed) { set ok = false }
    if !use! harness::check_i64("sandbox/permits/outside-reason", code, fs::reason_absolute()) { set ok = false }
    if !use! harness::check_str("sandbox/permits/reason-text", text, "absolute path is outside the sandbox root") { set ok = false }
    if !use! harness::check_str("sandbox/permits/denied-path", denied, "/etc/passwd") { set ok = false }
    return ok
}

@[test]
pub fn permits_anomaly_parent_escape: () :bool {
    // "../x" is a relative path that leaves the root; the reason is ESCAPE,
    // not ABSOLUTE.
    set allowed = fs::sandbox::permits("../x")
    set code = fs::sandbox::reason()
    set ok = true :bool mut
    if !use! harness::check_false("sandbox/permits/parent", allowed) { set ok = false }
    if !use! harness::check_i64("sandbox/permits/parent-reason", code, fs::reason_escape()) { set ok = false }
    use! harness::anomaly("fs/sandbox", "parent_escape", "../x", "denied + ESCAPE", strings::from::i64(code), code == fs::reason_escape())
    return ok
}

@[test]
pub fn get_root_success_defaults_to_cwd: () :bool {
    set base = cwd()
    set root = fs::sandbox::get_root()
    set ok = use! harness::check_str("sandbox/get-root", root, base)
    return ok
}

@[test]
pub fn deny_all_then_restore: () :bool {
    // deny_all stores the empty root: every absolute path is denied with
    // NO_ROOT until set_root is called again.
    set base = cwd()
    fs::sandbox::deny_all()
    set denied_root = fs::sandbox::get_root()
    set allowed = fs::sandbox::permits(strings::copy(strings::concat(base, "/x")))
    set code = fs::sandbox::reason()
    fs::sandbox::set_root(base)
    set restored_root = fs::sandbox::get_root()
    set restored = fs::sandbox::permits(strings::copy(strings::concat(base, "/x")))
    set ok = true :bool mut
    if !use! harness::check_str("sandbox/deny-root", denied_root, "") { set ok = false }
    if !use! harness::check_false("sandbox/deny-permits", allowed) { set ok = false }
    if !use! harness::check_i64("sandbox/deny-reason", code, fs::reason_no_root()) { set ok = false }
    if !use! harness::check_str("sandbox/restore-root", restored_root, base) { set ok = false }
    if !use! harness::check("sandbox/restore-permits", restored) { set ok = false }
    return ok
}

@[test]
pub fn set_root_anomaly_missing_path_fails_closed: () :bool {
    // A root that does not resolve to a directory is stored as empty, so a
    // typo denies everything rather than silently widening to "/".
    set base = cwd()
    fs::sandbox::set_root("/definitely/not/a/real/path-9f3a")
    set root = fs::sandbox::get_root()
    set allowed = fs::sandbox::permits(strings::copy(strings::concat(base, "/x")))
    set code = fs::sandbox::reason()
    fs::sandbox::set_root(base)
    set restored = fs::sandbox::permits(strings::copy(strings::concat(base, "/x")))
    set ok = true :bool mut
    if !use! harness::check_str("sandbox/bad-root", root, "") { set ok = false }
    if !use! harness::check_false("sandbox/bad-root-permits", allowed) { set ok = false }
    if !use! harness::check_i64("sandbox/bad-root-reason", code, fs::reason_no_root()) { set ok = false }
    if !use! harness::check("sandbox/bad-root-restored", restored) { set ok = false }
    use! harness::anomaly("fs/sandbox", "missing_root_fails_closed", "/does/not/exist", "empty root", root, root == "")
    return ok
}

@[test]
pub fn unsafe_depth_success: () :bool {
    set before = fs::sandbox::unsafe_depth()
    set first = fs::unrestricted::enter()
    set inside_one = fs::sandbox::unsafe_depth()
    set second = fs::unrestricted::enter()
    set inside_two = fs::sandbox::unsafe_depth()
    set first_exit = fs::unrestricted::exit()
    set after_first_exit = fs::sandbox::unsafe_depth()
    set second_exit = fs::unrestricted::exit()
    set after_second_exit = fs::sandbox::unsafe_depth()
    set extra_exit = fs::unrestricted::exit()
    set after_extra_exit = fs::sandbox::unsafe_depth()
    set ok = true :bool mut
    if !use! harness::check_i64("sandbox/depth/initial", before, 0) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/enter-first", first, 0) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/inside-one", inside_one, 1) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/enter-second", second, 1) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/inside-two", inside_two, 2) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/exit-first", first_exit, 2) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/after-first-exit", after_first_exit, 1) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/exit-second", second_exit, 1) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/after-second-exit", after_second_exit, 0) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/extra-exit", extra_exit, 0) { set ok = false }
    if !use! harness::check_i64("sandbox/depth/after-extra-exit", after_extra_exit, 0) { set ok = false }
    use! harness::anomaly("fs/sandbox", "unbalanced_exit_clamped", "exit at depth 0", "0", strings::from::i64(after_extra_exit), after_extra_exit == 0)
    return ok
}

@[test]
pub fn unrestricted_success_is_scoped: () :bool {
    set denied = fs::read("/etc/passwd")
    set exists = fs::unrestricted::exists("/etc/passwd")
    set content = fs::unrestricted::read("/etc/passwd")
    set depth = fs::sandbox::unsafe_depth()
    set ok = true :bool mut
    if !use! harness::check_str("sandbox/unrestricted/denied-read", denied, "") { set ok = false }
    if !use! harness::check("sandbox/unrestricted/exists", exists) { set ok = false }
    if !use! harness::check("sandbox/unrestricted/read", strings::len(content) > 0) { set ok = false }
    if !use! harness::check_i64("sandbox/unrestricted/depth-restored", depth, 0) { set ok = false }
    use! harness::anomaly("fs/sandbox", "unrestricted_read", "/etc/passwd", "non-empty, depth back to 0", strings::from::i64(strings::len(content)), strings::len(content) > 0 && depth == 0)
    return ok
}

@[test]
pub fn root_open_limit_outside: () :bool {
    set outside = fs::root::open("/etc")
    set outside_handle = outside.handle
    set parent = fs::root::open("..")
    set parent_handle = parent.handle
    use fs::root::close(outside)
    use fs::root::close(parent)
    set ok = true :bool mut
    if !use! harness::check_i64("sandbox/root/outside", outside_handle, 0) { set ok = false }
    if !use! harness::check_i64("sandbox/root/parent", parent_handle, 0) { set ok = false }
    return ok
}

@[test]
pub fn root_relative_child_escape_denied: () :bool {
    set root = fs::root::open(".")
    set escaped = fs::file::open::read(root, "../etc/passwd")
    set handle = escaped.handle
    use fs::file::close(escaped)
    set ok = use! harness::check_i64("sandbox/root/dotdot-child", handle, 0)
    return ok
}

@[test]
pub fn root_absolute_child_escape_anomaly: () :bool {
    // SECURITY: opening an absolute child path through a capability root must
    // stay inside that root. The runtime treats "/etc/passwd" as absolute and
    // opens it directly, so a sandboxed program can read any file the user
    // can. Expected handle 0 and size -1; observed a live handle and the real
    // file size.
    set root = fs::root::open(".")
    set escaped = fs::file::open::read(root, "/etc/passwd")
    set handle = escaped.handle
    set size = fs::file::size(escaped)

    set dir_root = fs::root::open(".")
    set dir_handle = fs::dir::open(dir_root, "/etc").handle

    set ok = true :bool mut
    if !use! harness::check_i64("sandbox/root/absolute-child-handle", handle, 0) { set ok = false }
    if !use! harness::check_i64("sandbox/root/absolute-child-size", size, -1) { set ok = false }
    if !use! harness::check_i64("sandbox/root/absolute-child-dir", dir_handle, 0) { set ok = false }
    use! harness::anomaly("fs/sandbox", "root_absolute_child_escape", "/etc/passwd via root", "denied", strings::from::i64(size), size == -1)
    return ok
}

// ═══ Integration cases moved from tests/fs/sandbox/mod.mr ═══════

fn setup: (name :&str) :str {
    // Fixtures live under tests/fs/fixtures/tmp/, which is itself inside the
    // sandbox root (the package working directory). Nothing is created in the
    // repository root.
    return use! harness::fixture_dir("fs/sandbox", name)
}

fn teardown: (d :&str) {
    use! harness::fixture_cleanup(d)
}

// ═══ Default posture ═══════════════════════════════════════════

@[test]
pub fn default_root_is_the_working_directory: () :bool {
    // The root must be a real, absolute, existing directory or nothing works.
    set root = fs::sandbox::get_root()
    if root == "" {
        return false
    }
    if !fs::exists(root) {
        return false
    }
    if !fs::sandbox::permits("some-file.txt") {
        return false
    }
    return true
}

@[test]
pub fn default_depth_is_zero: () :bool {
    // Nothing should have opened a scope behind the caller's back; a program
    // that starts with the policy already suspended is not default-deny.
    if fs::sandbox::unsafe_depth() != 0 {
        return false
    }
    return true
}

@[test]
pub fn relative_paths_inside_the_root_are_allowed: () :bool {
    set d = setup("relative_paths_inside_the_root_are_allowed")
    if d == "" {
        return false
    }
    fs::write(fs::path::join(d, "allowed.txt") "payload")
    set ok = fs::exists(fs::path::join(d, "allowed.txt"))
    use teardown(d)
    return ok
}

// ═══ Denied by default ═════════════════════════════════════════

@[test]
pub fn absolute_path_outside_the_root_is_denied: () :bool {
    // /etc/hostname exists on every Linux box this runs on, so a false here
    // means the policy blocked it, not that the file was missing. The
    // precondition is checked through the unrestricted variant: asking
    // "does /etc/hostname exist" through the sandboxed call would answer "no"
    // by policy, and the test would pass for the wrong reason.
    if !fs::unrestricted::exists("/etc/hostname") {
        return false
    }
    if fs::sandbox::permits("/etc/hostname") {
        return false
    }
    return true
}

@[test]
pub fn denied_absolute_read_returns_empty: () :bool {
    // fs::read must not hand back the contents even though the file is
    // readable by this process. Returning the data would make the check
    // cosmetic.
    if fs::exists("/etc/hostname") {
        if len(fs::read("/etc/hostname")) != 0 {
            return false
        }
    }
    return true
}

@[test]
pub fn denied_absolute_exists_reports_false: () :bool {
    if fs::exists("/etc/hostname") {
        if fs::exists("/etc/hostname") {
            return false
        }
    }
    return true
}

@[test]
pub fn denial_carries_a_reason: () :bool {
    // A silent false is not a security control you can debug or alert on.
    use fs::sandbox::permits("/etc/hostname")
    if fs::sandbox::reason() == fs::reason_none() {
        return false
    }
    if fs::sandbox::reason_text() == "" {
        return false
    }
    if fs::sandbox::reason_text() == "allowed" {
        return false
    }
    return true
}

@[test]
pub fn parent_traversal_is_denied: () :bool {
    if fs::sandbox::permits("../etc/hostname") {
        return false
    }
    if fs::sandbox::permits("../../etc/hostname") {
        return false
    }
    return true
}

@[test]
pub fn traversal_that_looks_innocent_is_still_denied: () :bool {
    // The join happens before normalisation, so a path that STARTS inside the
    // root and climbs out later must be caught. This is the shape an attacker
    // actually uses.
    set d = setup("traversal_that_looks_innocent_is_still_denied")
    if d == "" {
        return false
    }
    set sneaky = strings::concat(d, "/../../../../../../etc/hostname")
    if fs::sandbox::permits(sneaky) {
        use teardown(d)
        return false
    }
    if fs::sandbox::reason() != fs::reason_escape() {
        use teardown(d)
        return false
    }
    use teardown(d)
    return true
}

@[test]
pub fn filesystem_root_is_denied: () :bool {
    if fs::sandbox::permits("/") {
        return false
    }
    return true
}

@[test]
pub fn sibling_prefix_is_not_a_match: () :bool {
    // "<root>_evil" starts with the root as a STRING but is a different
    // directory. A prefix test that forgets the trailing separator lets this
    // through, which is why it gets its own test.
    set root = fs::sandbox::get_root()
    if root == "" {
        return false
    }
    set evil = strings::concat(root, "_evil/passwd")
    if fs::sandbox::permits(evil) {
        return false
    }
    return true
}

// ═══ Symlink escapes ══════════════════════════════════════════

@[test]
pub fn symlink_pointing_out_of_the_root_is_denied: () :bool {
    set d = setup("symlink_pointing_out_of_the_root_is_denied")
    if d == "" {
        return false
    }
    set link = fs::path::join(d, "escape")
    fs::drop(link)
    set made = proc::run::output("/bin/ln" ["-sfn" "/etc" link])
    if proc::run::last_exit() != 0 {
        use teardown(d)
        return false
    }
    if fs::sandbox::permits(fs::path::join(link, "hostname")) {
        use teardown(d)
        return false
    }
    if fs::sandbox::reason() != fs::reason_symlink() {
        use teardown(d)
        return false
    }
    use teardown(d)
    return true
}

@[test]
pub fn reading_through_an_escaping_symlink_returns_nothing: () :bool {
    set d = setup("reading_through_an_escaping_symlink_returns_nothing")
    if d == "" {
        return false
    }
    set link = fs::path::join(d, "escape2")
    fs::drop(link)
    set made = proc::run::output("/bin/ln" ["-sfn" "/etc" link])
    if proc::run::last_exit() != 0 {
        use teardown(d)
        return false
    }
    if len(fs::read(fs::path::join(link, "hostname"))) != 0 {
        use teardown(d)
        return false
    }
    use teardown(d)
    return true
}

@[test]
pub fn symlink_that_stays_inside_the_root_is_allowed: () :bool {
    // A policy that denies every link is not a policy, it is a broken one.
    set d = setup("symlink_that_stays_inside_the_root_is_allowed")
    if d == "" {
        return false
    }
    set real = fs::path::join(d, "real")
    set link = fs::path::join(d, "inside_link")
    fs::write(fs::path::join(real, "note.txt") "hello")
    fs::drop(link)
    set made = proc::run::output("/bin/ln" ["-sfn" real link])
    if proc::run::last_exit() != 0 {
        use teardown(d)
        return false
    }
    set ok = fs::sandbox::permits(fs::path::join(link, "note.txt"))
    use teardown(d)
    return ok
}

@[test]
pub fn escaping_symlink_can_still_be_removed: () :bool {
    // The asymmetry that matters: you may DELETE a link that points outside the
    // sandbox, because unlinking a link does not follow it. If removal were
    // blocked, a program could not clean up after itself.
    set d = setup("escaping_symlink_can_still_be_removed")
    if d == "" {
        return false
    }
    set link = fs::path::join(d, "removable")
    fs::drop(link)
    set made = proc::run::output("/bin/ln" ["-sfn" "/etc" link])
    if proc::run::last_exit() != 0 {
        use teardown(d)
        return false
    }
    set removed = fs::remove(link)
    use teardown(d)
    return removed
}

// ═══ The escape hatch actually opens it ═══════════════════════

@[test]
pub fn unrestricted_read_reads_what_the_default_refused: () :bool {
    // The grant has to be a real grant. This is the test that would fail if
    // unrestricted::read were implemented as a copy of the sandboxed path.
    if !fs::unrestricted::exists("/etc/hostname") {
        return false
    }
    if len(fs::read("/etc/hostname")) != 0 {
        return false
    }
    if len(fs::unrestricted::read("/etc/hostname")) == 0 {
        return false
    }
    return true
}

@[test]
pub fn enter_and_exit_balance: () :bool {
    set before = fs::sandbox::unsafe_depth()
    set was = fs::unrestricted::enter()
    if fs::sandbox::unsafe_depth() != was + 1 {
        return false
    }
    if !fs::sandbox::permits("/etc/hostname") {
        return false
    }
    use fs::unrestricted::exit()
    if fs::sandbox::unsafe_depth() != was {
        return false
    }
    if fs::sandbox::permits("/etc/hostname") {
        return false
    }
    if fs::sandbox::unsafe_depth() != before {
        return false
    }
    return true
}

@[test]
pub fn nested_scopes_unwind_independently: () :bool {
    // Leaving an inner scope must not close the outer one: a program with two
    // nested grants and one exit should still hold the outer grant.
    set was = fs::unrestricted::enter()
    set inner = fs::unrestricted::enter()
    if fs::sandbox::unsafe_depth() != was + 2 {
        return false
    }
    use fs::unrestricted::exit()
    if fs::sandbox::unsafe_depth() != was + 1 {
        return false
    }
    if !fs::sandbox::permits("/etc/hostname") {
        return false
    }
    use fs::unrestricted::exit()
    if fs::sandbox::permits("/etc/hostname") {
        return false
    }
    return true
}

@[test]
pub fn unbalanced_exit_does_not_invert_the_policy: () :bool {
    // A depth that is already zero stays zero. If it wrapped instead, calling
    // exit more times than enter would flip the check and allow everything.
    set before = fs::sandbox::unsafe_depth()
    if before != 0 {
        return false
    }
    use fs::unrestricted::exit()
    use fs::unrestricted::exit()
    if fs::sandbox::unsafe_depth() != 0 {
        return false
    }
    if fs::sandbox::permits("/etc/hostname") {
        return false
    }
    return true
}

@[test]
pub fn unrestricted_exists_agrees_with_the_filesystem: () :bool {
    if !fs::unrestricted::exists("/etc/hostname") {
        return false
    }
    if fs::unrestricted::exists("/etc/definitely-not-here-12345") {
        return false
    }
    return true
}

// ═══ Shell is denied by default ═══════════════════════════════

@[test]
pub fn shell_is_denied_by_default: () :bool {
    set out = proc::shell("echo pwned")
    if out != "" {
        return false
    }
    if fs::last_error() != fs::err_permission() {
        return false
    }
    if proc::shell_status() != -1 {
        return false
    }
    return true
}

@[test]
pub fn shell_runs_inside_an_explicit_scope: () :bool {
    // The grant must genuinely execute: if this returns false the gate is
    // denying everything, which the deny tests above would not catch.
    set was = fs::unrestricted::enter()
    set out = proc::shell("echo marker-value")
    use fs::unrestricted::exit()
    if !strings::contains(out, "marker-value") {
        return false
    }
    return true
}

@[test]
pub fn shell_reports_the_exit_status: () :bool {
    set was = fs::unrestricted::enter()
    set out = proc::shell("exit 7")
    set st = proc::shell_status()
    use fs::unrestricted::exit()
    if st != 7 {
        return false
    }
    return true
}

@[test]
pub fn shell_captures_stderr_too: () :bool {
    // A command that fails with a message must not lose the message, or the
    // caller cannot tell a silent failure from a hang.
    set was = fs::unrestricted::enter()
    set out = proc::shell("echo problem-here >&2")
    use fs::unrestricted::exit()
    if !strings::contains(out, "problem-here") {
        return false
    }
    return true
}

@[test]
pub fn shell_is_denied_again_after_the_scope_closes: () :bool {
    // The property that makes a scope a scope: the hole closes.
    set was = fs::unrestricted::enter()
    set out1 = proc::shell("echo first")
    use fs::unrestricted::exit()
    set out2 = proc::shell("echo second")
    if out1 == "" {
        return false
    }
    if out2 != "" {
        return false
    }
    return true
}

@[test]
pub fn argv_api_still_works_without_any_scope: () :bool {
    // The whole point of default-deny is not "no processes". argv execution
    // involves no shell and no parsing, so it needs no grant. If this fails
    // the sandbox has broken ordinary use and every consumer will need to
    // opt in, which would make the gate useless in practice.
    set out = proc::run::output("/bin/echo" ["plain-argv"])
    if !strings::contains(out, "plain-argv") {
        return false
    }
    if fs::sandbox::unsafe_depth() != 0 {
        return false
    }
    return true
}
