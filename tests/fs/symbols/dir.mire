@[test]
pub fn dir_remove_success_empty: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "remove-empty")
    set child = strings::copy(fs::path::join(dir, "one"))
    use fs::dir::create(child)
    set removed = fs::dir::remove(child)
    set present = fs::exists(child)
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check("dir/remove", removed) { set ok = false }
    if !use! harness::check_false("dir/remove-gone", present) { set ok = false }
    return ok
}

@[test]
pub fn dir_remove_anomaly_non_empty: () :bool {
    // A non-empty directory cannot be removed. Note that this surface leaves
    // last_error at OK; fs::remove is the one that reports NOT_EMPTY.
    set dir = use! harness::fixture_dir("fs/dir", "remove-non-empty")
    set child = strings::copy(fs::path::join(dir, "one"))
    use fs::dir::create(child)
    use fs::write(strings::copy(fs::path::join(child, "note.txt")), "x")
    set removed = fs::dir::remove(child)
    set code = fs::last_error()
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check_false("dir/remove-non-empty", removed) { set ok = false }
    use! harness::anomaly("fs/dir", "dir_remove_non_empty_error", "non-empty dir", "NOT_EMPTY", strings::from::i64(code), code == fs::err_not_empty())
    return ok
}

@[test]
pub fn remove_success_file_and_empty_dir: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "remove")
    set file = strings::copy(fs::path::join(dir, "note.txt"))
    use fs::write(file, "x")
    set file_removed = fs::remove(file)
    set empty = strings::copy(fs::path::join(dir, "empty"))
    use fs::dir::create(empty)
    set empty_removed = fs::remove(empty)
    set file_present = fs::exists(file)
    set empty_present = fs::exists(empty)
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check("dir/remove-file", file_removed) { set ok = false }
    if !use! harness::check_false("dir/remove-file-gone", file_present) { set ok = false }
    if !use! harness::check("dir/remove-empty", empty_removed) { set ok = false }
    if !use! harness::check_false("dir/remove-empty-gone", empty_present) { set ok = false }
    return ok
}

@[test]
pub fn remove_limit_missing: () :bool {
