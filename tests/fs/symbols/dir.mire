@[test]
pub fn remove_all_anomaly_missing: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "remove-all-missing")
    set ghost = strings::copy(fs::path::join(dir, "ghost"))
    set removed = fs::remove_all(ghost)
    set code = fs::last_error()
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check_false("dir/remove-all-missing", removed) { set ok = false }
    if !use! harness::check_i64("dir/remove-all-missing-code", code, fs::err_not_found()) { set ok = false }
    use! harness::anomaly("fs/dir", "remove_all_missing", "ghost", "false + NOT_FOUND", strings::from::i64(code), code == fs::err_not_found())
    return ok
}

@[test]
pub fn mkdirs_success_nested: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "mkdirs")
    set deep = strings::copy(fs::path::join(dir, "a/b/c"))
    set created = fs::owl::mkdirs(deep)
    set a = fs::exists(strings::copy(fs::path::join(dir, "a")))
    set b = fs::exists(strings::copy(fs::path::join(dir, "a/b")))
    set c = fs::exists(deep)
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check("dir/mkdirs", created) { set ok = false }
    if !use! harness::check("dir/mkdirs-a", a) { set ok = false }
    if !use! harness::check("dir/mkdirs-b", b) { set ok = false }
    if !use! harness::check("dir/mkdirs-c", c) { set ok = false }
    return ok
}

@[test]
pub fn mkdirs_limit_existing_and_trailing_slash: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "mkdirs-limit")
    set existing = fs::owl::mkdirs(dir)
    set trailing = strings::copy(strings::concat(fs::path::join(dir, "tr1"), "/"))
    set created = fs::owl::mkdirs(trailing)
    set present = fs::exists(strings::copy(fs::path::join(dir, "tr1")))
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check("dir/mkdirs-existing", existing) { set ok = false }
    if !use! harness::check("dir/mkdirs-trailing", created) { set ok = false }
    if !use! harness::check("dir/mkdirs-trailing-exists", present) { set ok = false }
    return ok
}

@[test]
pub fn mkdirs_anomaly_empty_and_file_component: () :bool {
    // The empty path is not a directory, and a regular file can never become
    // an intermediate level, so both must fail.
    set dir = use! harness::fixture_dir("fs/dir", "mkdirs-bad")
    set blocker = strings::copy(fs::path::join(dir, "blocker"))
    use fs::write(blocker, "x")
    set under_file = fs::owl::mkdirs(strings::copy(fs::path::join(blocker, "child")))
    set empty = fs::owl::mkdirs("")
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check_false("dir/mkdirs-under-file", under_file) { set ok = false }
    if !use! harness::check_false("dir/mkdirs-empty", empty) { set ok = false }
    use! harness::anomaly("fs/dir", "mkdirs_file_component", "blocker/child", "false", strings::from::bool(under_file), !under_file)
    return ok
}

@[test, ignore]
pub fn list_quarantined_corrupt_vector: () :bool {
    // Enable only after the runtime's list push is fixed. fs::list currently
    // returns a corrupt vector and the test binary dies with SIGSEGV before
    // the assertions can run.
    set dir = use! harness::fixture_dir("fs/dir", "list")
    use fs::write(strings::copy(fs::path::join(dir, "a.txt")), "x")
    set entries = fs::list(dir)
    use! harness::fixture_cleanup(dir)
    return use! harness::check_i64("dir/list-len", vec::len(entries), 2)
}