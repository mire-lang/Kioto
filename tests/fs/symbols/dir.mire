// Per-symbol suite: kioto::fs::{mkdir,dir::create,dir::remove,remove,remove_all}
// and kioto::fs::owl::mkdirs.
//
// Two different removal surfaces: fs::remove reports an error code (NOT_EMPTY
// for a non-empty directory), while fs::dir::remove does not. fs::remove_all
// is the recursive one and removes files as well as trees.
//
// fs::list is quarantined: on this runtime it returns a corrupt vector
// (vec::len reports 0x59584eb3360e6b33) and usually kills the process with
// SIGSEGV, so no public directory-enumeration path is testable yet. The
// ignored case below is the test to enable when that is fixed.

load kioto
load! /tests/_support/harness

@[test]
pub fn mkdir_success_single_level: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "mkdir")
    set child = strings::copy(fs::path::join(dir, "one"))
    set created = fs::mkdir(child)
    set present = fs::exists(child)
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check("dir/mkdir", created) { set ok = false }
    if !use! harness::check("dir/mkdir-exists", present) { set ok = false }
    return ok
}

@[test]
pub fn mkdir_limit_already_exists_and_missing_parent: () :bool {
    // Documented: false covers both "already exists" and "parent missing",
    // and neither sets an error code.
    set dir = use! harness::fixture_dir("fs/dir", "mkdir-limit")
    set child = strings::copy(fs::path::join(dir, "one"))
    use fs::mkdir(child)
    set again = fs::mkdir(child)
    set again_code = fs::last_error()
    set nested = strings::copy(fs::path::join(dir, "no/child"))
    set missing_parent = fs::mkdir(nested)
    set missing_code = fs::last_error()
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check_false("dir/mkdir-again", again) { set ok = false }
    if !use! harness::check_i64("dir/mkdir-again-code", again_code, fs::err_ok()) { set ok = false }
    if !use! harness::check_false("dir/mkdir-missing-parent", missing_parent) { set ok = false }
    if !use! harness::check_i64("dir/mkdir-missing-parent-code", missing_code, fs::err_ok()) { set ok = false }
    return ok
}

