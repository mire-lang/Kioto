    if !use! harness::check_i64("dir/remove-missing-code", code, fs::err_not_found()) { set ok = false }
    return ok
}

@[test]
pub fn remove_anomaly_non_empty_tree: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "remove-tree")
    set child = strings::copy(fs::path::join(dir, "one"))
    use fs::dir::create(child)
    use fs::write(strings::copy(fs::path::join(child, "note.txt")), "x")
    set removed = fs::remove(child)
    set code = fs::last_error()
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check_false("dir/remove-tree", removed) { set ok = false }
    if !use! harness::check_i64("dir/remove-tree-code", code, fs::err_not_empty()) { set ok = false }
    use! harness::anomaly("fs/dir", "remove_non_empty", "tree", "NOT_EMPTY", strings::from::i64(code), code == fs::err_not_empty())
    return ok
}

@[test]
pub fn remove_all_success_tree: () :bool {
    set dir = use! harness::fixture_dir("fs/dir", "remove-all")
    set child = strings::copy(fs::path::join(dir, "one"))
    set nested = strings::copy(fs::path::join(child, "two"))
    use fs::owl::mkdirs(nested)
    use fs::write(strings::copy(fs::path::join(child, "a.txt")), "x")
    use fs::write(strings::copy(fs::path::join(nested, "b.txt")), "y")
    set removed = fs::remove_all(child)
    set present = fs::exists(child)
    use! harness::fixture_cleanup(dir)
    set ok = true :bool mut
    if !use! harness::check("dir/remove-all", removed) { set ok = false }
    if !use! harness::check_false("dir/remove-all-gone", present) { set ok = false }
    return ok
}

