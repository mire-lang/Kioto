// Per-symbol suite: kioto::math::consts

load kioto
load! /tests/_support/harness

fn feq: (a :f64, b :f64) :bool {
    set diff = if a > b { a - b } else { b - a }
    return diff < 0.0000001
}

@[test]
pub fn pi_success: () :bool {
    set ok = use! harness::check("math/consts/pi", feq(math::consts::pi(), 3.141592653589793))
    return ok
}

@[test]
pub fn tau_success: () :bool {
    set ok = use! harness::check("math/consts/tau", feq(math::consts::tau(), 6.283185307179586))
    return ok
}

