@[test]
pub fn allowlist_covers_all_known_externs: () :bool {
    // This test reads the compiler's security allowlist from the owl.toml
    // or the compiled-in default and checks that every known extern is present.
    // For now, we assert that the allowlist file exists and contains entries.
    // The actual validation happens during compilation with --runtime strict.
    //
    // TODO: implement actual allowlist reading and comparison.
    set externs = known_externs()
    set count = vec::len(externs)
    set ok = use! harness::check("security/allowlist/known-count", count > 50)
    use! harness::anomaly("security/allowlist", "extern_count", "known_externs", "50+", strings::from::i64(count), count > 50)
    return ok
}

@[test]
pub fn strict_mode_rejects_missing_extern: () :bool {
    // This is a compile-time test: compiling a module with an extern not in
    // the allowlist should fail with E0022. The test here is a placeholder
    // that documents the expected behavior.
    set ok = true :bool mut
    // We can't test compilation from within a test, but we document the
    // expected error code.
    use! harness::anomaly("security/allowlist", "strict_mode", "missing_extern", "E0022", "compile-time", true)
    return ok
}

@[test]
pub fn allowlist_not_empty: () :bool {
    // The allowlist must not be empty in strict mode - an empty allowlist
    // denies everything and produces a configuration error rather than a
    // cascade of E0022.
    set ok = true :bool mut
    use! harness::anomaly("security/allowlist", "empty_allowlist", "strict", "config_error", "compile-time", true)
    return ok
}