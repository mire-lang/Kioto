load kioto

@[test]
pub fn test_sha256_known_vectors: () :bool {
    set empty = crypto::hash::sha256("")
    set abc = crypto::hash::sha256("abc")
    return empty == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" &&
        abc == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
}

@[test]
pub fn test_sha512_known_vectors: () :bool {
    set empty = crypto::hash::sha512("")
    set abc = crypto::hash::sha512("abc")
    return empty == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" &&
        abc == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
}

@[test]
pub fn test_ed25519_roundtrip_and_rejection: () :bool {
    set secret = crypto::sign::ed25519::secret::new()
    set public = crypto::sign::ed25519::secret::public(secret)
    set signature = crypto::sign::ed25519::secret::sign(secret "mire crypto")
    set valid = crypto::sign::ed25519::public::verify(public "mire crypto" signature)
    set rejected = crypto::sign::ed25519::public::verify(public "changed message" signature)
    crypto::sign::ed25519::secret::close(secret)
    crypto::sign::ed25519::public::close(public)
    return valid && !rejected
}

@[test]
pub fn test_secure_random_shape: () :bool {
    set first = crypto::random::secure::bytes(32)
    set second = crypto::random::secure::bytes(32)
    set different = false :bool mut
    set i = 0 :i64 mut
    while i < 32 {
        if vec::get::i64(first i) != vec::get::i64(second i) {
            set different = true
        }
        set i += 1
    }
    return vec::len(first) == 32 && vec::len(second) == 32 && different
}
