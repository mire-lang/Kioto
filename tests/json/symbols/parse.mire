// Per-symbol suite: kioto::json::{parse,stringify,constructors,type checks,getters,array,object}

load json
load! /tests/_support/harness

@[test]
pub fn parse_success: () :bool {
    set input = "{\"name\": \"test\", \"value\": 42, \"flag\": true}"
    set v = json::parse(input)
    set ok = true :bool mut
    if !use! harness::check("json/parse/is-object", json::is_object(v)) { set ok = false }
    if !use! harness::check_i64("json/parse/len", json::object_len(v), 3) { set ok = false }
    return ok
}

@[test]
pub fn parse_limit_empty: () :bool {
    set v = json::parse("{}")
    set ok = use! harness::check("json/parse/empty-object", json::is_object(v))
    return ok
}

@[test]
pub fn constructors_success: () :bool {
    set ok = true :bool mut
    if !use! harness::check("json/ctor/null", json::is_null(json::null())) { set ok = false }
    if !use! harness::check("json/ctor/bool", json::is_bool(json::bool_val(true))) { set ok = false }
    if !use! harness::check("json/ctor/number", json::is_number(json::number(3.14))) { set ok = false }
    if !use! harness::check("json/ctor/string", json::is_string(json::string_val("hello"))) { set ok = false }
    if !use! harness::check("json/ctor/array", json::is_array(json::array())) { set ok = false }
    if !use! harness::check("json/ctor/object", json::is_object(json::object())) { set ok = false }
    return ok
}

@[test]
pub fn getters_success: () :bool {
    set ok = true :bool mut
    if !use! harness::check("json/get/bool", json::as_bool(json::bool_val(true))) { set ok = false }
    if !use! harness::check("json/get/number", feq(json::as_number(json::number(3.14)), 3.14)) { set ok = false }
    if !use! harness::check_i64("json/get/i64", json::as_i64(json::number(42)), 42) { set ok = false }
    if !use! harness::check_str("json/get/string", json::as_string(json::string_val("hello")), "hello") { set ok = false }
    return ok
}

fn feq: (a :f64, b :f64) :bool {
    set diff = if a > b { a - b } else { b - a }
    return diff < 0.0000001
}

@[test]
pub fn array_ops_success: () :bool {
    set a = json::array() :JsonValue mut
    set a = json::array_push(a, json::number(1))
    set a = json::array_push(a, json::number(2))
    set ok = true :bool mut
    if !use! harness::check_i64("json/array/len", json::array_len(a), 2) { set ok = false }
    set first = json::array_get(a, 0)
    if !use! harness::check_i64("json/array/get", json::as_i64(first), 1) { set ok = false }
    return ok
}

@[test]
pub fn object_ops_success: () :bool {
    set o = json::object() :JsonValue mut
    set o = json::object_set(o, "key", json::string_val("value"))
    set ok = true :bool mut
    if !use! harness::check_i64("json/object/len", json::object_len(o), 1) { set ok = false }
    set got = json::object_get(o, "key")
    if !use! harness::check_str("json/object/get", json::as_string(got), "value") { set ok = false }
    // Missing key returns null
    set missing = json::object_get(o, "missing")
    if !use! harness::check("json/object/missing", json::is_null(missing)) { set ok = false }
    return ok
}

@[test]
pub fn stringify_success: () :bool {
    set o = json::object() :JsonValue mut
    set o = json::object_set(o, "name", json::string_val("test"))
    set o = json::object_set(o, "value", json::number(42))
    set s = json::stringify(o)
    // Stringify produces compact JSON without whitespace
    set ok = true :bool mut
    if !use! harness::check("json/stringify/has-name", strings::contains(s, "name")) { set ok = false }
    if !use! harness::check("json/stringify/has-value", strings::contains(s, "42")) { set ok = false }
    return ok
}

@[test]
pub fn parse_roundtrip: () :bool {
    set original = "{\"a\":1,\"b\":2}"
    set parsed = json::parse(original)
    set s = json::stringify(parsed)
    set reparsed = json::parse(s)
    set a = json::as_i64(json::object_get(reparsed, "a"))
    set b = json::as_i64(json::object_get(reparsed, "b"))
    set ok = true :bool mut
    if !use! harness::check_i64("json/roundtrip/a", a, 1) { set ok = false }
    if !use! harness::check_i64("json/roundtrip/b", b, 2) { set ok = false }
    return ok
}