// Per-symbol suite: kioto::strings::substr
//
// Clamped rather than checked: a negative start becomes 0, a length past the
// end is cut short, and a length of zero or less is the empty string.

load kioto
load! /tests/_support/harness

@[test]
pub fn substr_success_middle: () :bool {
    set ok = true :bool mut
    if !use! harness::check_str("substr/middle", strings::substr("abcdef", 1, 3), "bcd") { set ok = false }
    if !use! harness::check_str("substr/front", strings::substr("abcdef", 0, 3), "abc") { set ok = false }
    return ok
}

@[test]
pub fn substr_limit_zero_len: () :bool {
    set ok = use! harness::check_str("substr/zero-len", strings::substr("abcdef", 2, 0), "")
    return ok
}

@[test]
pub fn substr_limit_start_at_end: () :bool {
    set ok = use! harness::check_str("substr/start-at-end", strings::substr("abcdef", 6, 1), "")
    return ok
}

@[test]
pub fn substr_anomaly_negative_start_clamped: () :bool {
    set ok = true :bool mut
    set got = strings::substr("abcdef", -2, 3)
    if !use! harness::check_str("substr/negative-start", got, "abc") { set ok = false }
    use! harness::anomaly("strings/substr", "negative_start", "abcdef|-2|3", "abc", got, got == "abc")
    return ok
}

@[test]
pub fn substr_anomaly_len_past_end_is_cut: () :bool {
    set ok = true :bool mut
    set got = strings::substr("abcdef", 4, 100)
    if !use! harness::check_str("substr/past-end", got, "ef") { set ok = false }
    use! harness::anomaly("strings/substr", "len_past_end", "abcdef|4|100", "ef", got, got == "ef")
    return ok
}

@[test]
pub fn substr_anomaly_negative_len_is_empty: () :bool {
    set ok = true :bool mut
    set got = strings::substr("abcdef", 2, -1)
    if !use! harness::check_str("substr/negative-len", got, "") { set ok = false }
    use! harness::anomaly("strings/substr", "negative_len", "abcdef|2|-1", "", got, got == "")
    return ok
}

@[test]
pub fn substr_limit_empty_source: () :bool {
    set ok = use! harness::check_str("substr/empty-source", strings::substr("", 0, 5), "")
    return ok
}
