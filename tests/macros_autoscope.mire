load kioto

// Verifies that the mire library macros (`assert!`, `dbg!`) are auto-scoped
// into a kioto project (which depends on mire) WITHOUT any explicit `load`.
// If auto-scope wiring is broken these fail to compile with E0019.

@[test]
pub fn test_macro_autoscope: () :bool {
    set x = dbg!(42)
    assert!(x == 42 "dbg! should return the passed value")
    assert!(vec::len([1 2 3] :vec[i64]) == 3 "vec::len")
    return true
}
