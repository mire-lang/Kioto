module cli
load kioto::strings
load mire::vec
load kioto::cli::_externs

pub fn parse: (raw :&vec[str]) :map[str str] {
    set result = {"command": ""} :map[str str] mut
    if vec::len(raw) > 0 {
        set result["command"] = vec::get::str(raw 0)
    }
    set i = 1 :i64 mut
    while i < vec::len(raw) {
        set arg = vec::get::str(raw i)
        if strings::starts::with(arg "--") {
            set an = strings::len(arg)
            set flag = strings::substr(arg 2 an - 2)
            set i += 1
            if i < vec::len(raw) {
                set result[flag] = vec::get::str(raw i)
            }
        }
        set i += 1
    }
    return result
}