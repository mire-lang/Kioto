module fs

load kioto::strings

pub struct Root {
    handle :i64
}

pub struct File {
    handle :i64
}

pub struct Dir {
    handle :i64
}

extern fn pal_root_open: (path :&str) :i64 lib "c"
extern fn pal_root_close: (root :i64) lib "c"
extern fn pal_file_open: (root :i64, path :&str, flags :i32) :i64 lib "c"
extern fn pal_file_read: (file :i64, buf :&str, len :i64) :i64 lib "c"
extern fn pal_file_write: (file :i64, data :&str, len :i64) :i64 lib "c"
extern fn pal_file_seek: (file :i64, offset :i64, whence :i32) :i64 lib "c"
extern fn pal_file_size: (file :i64) :i64 lib "c"
extern fn pal_file_close: (file :i64) lib "c"
extern fn pal_dir_open: (root :i64, path :&str) :i64 lib "c"
extern fn pal_dir_next_name: (dir :i64, out :&mut str, cap :i64) :i64 lib "c"
extern fn pal_dir_close: (dir :i64) lib "c"

extern fn pal_fs_exists: (path :&str) :bool lib "c"
extern fn pal_fs_mkdir: (path :&str) :bool lib "c"
extern fn pal_fs_rmdir: (path :&str) :bool lib "c"
extern fn pal_fs_unlink: (path :&str) :bool lib "c"
extern fn pal_fs_remove: (path :&str) :bool lib "c"
extern fn pal_root_remove: (root :i64, path :&str) :bool lib "c"
extern fn pal_last_error: () :i64 lib "c"
extern fn rt_fs_read_bytes: (path :&str) :str lib "c"
extern fn rt_vecs_push_ptr: (list :vec[str], value :str) :vec[str] lib "c"
extern fn rt_strings_char_at: (s :&str, i :i64) :i64 lib "c"
extern fn rt_strings_substr: (s :&str, start :i64, len :i64) :str lib "c"
extern fn rt_string_concat: (left :&str, right :&str) :str lib "c"

cons PAL_OPEN_READ = 1 :i32
cons PAL_OPEN_WRITE = 2 :i32
cons PAL_OPEN_CREATE = 4 :i32
cons PAL_OPEN_TRUNCATE = 8 :i32
cons PAL_OPEN_APPEND = 16 :i32
cons PAL_SEEK_BEGIN = 0 :i32
cons PAL_SEEK_CURRENT = 1 :i32
cons PAL_SEEK_END = 2 :i32

// PAL error codes (pal.h pal_error_code_t). fs::last_error() returns these.
cons PAL_ERR_OK = 0 :i64
cons PAL_ERR_NOT_FOUND = 1 :i64
cons PAL_ERR_PERMISSION = 2 :i64
cons PAL_ERR_IO = 3 :i64
cons PAL_ERR_INVALID = 4 :i64
cons PAL_ERR_NO_MEM = 5 :i64
cons PAL_ERR_BUSY = 6 :i64
cons PAL_ERR_UNSUPPORTED = 7 :i64
cons PAL_ERR_ALREADY_EXISTS = 8 :i64
cons PAL_ERR_INVALID_HANDLE = 9 :i64
cons PAL_ERR_OWNERSHIP = 10 :i64
cons PAL_ERR_NOT_EMPTY = 11 :i64

pub fn exists: (path :&str) :bool {
    return pal_fs_exists(path)
}

pub fn read: (path :&str) :str {
    return rt_fs_read_bytes(path)
}

pub fn write: (path :&str, data :&str) {
    set root = pal_root_open(".")
    set f = pal_file_open(root, path, 14 :i32)
    pal_file_write(f, data, len(data))
    pal_file_close(f)
    pal_root_close(root)
}

pub fn drop: (path :&str) :bool {
    return pal_fs_unlink(path)
}

// ── remove / remove_all (capability-based, symlinks never followed) ─────────
// pal_root_remove unlinks a SINGLE entry (file, symlink, or empty dir) relative
// to a root handle; a trailing symlink is unlinked, never followed. We open the
// root on the target's PARENT directory and pass the basename (plus descendants
// during recursion) as the relative path, so every PAL call re-validates inside
// the sandbox. Recursive removal is composed here over pal_dir_open +
// pal_root_remove — never in PAL.

// Private: recursively remove everything under `rel` inside `root`.
fn fs_remove_recursive: (root :i64, rel :&str) :bool {
    set d = pal_dir_open(root, rel)
    if d <= 0 {
        return pal_root_remove(root, rel)
    }
    set entry = strings::repeat("\0" 256) :str mut
    set n = pal_dir_next_name(d, entry, 256) :i64 mut
    while n > 0 {
        set name = rt_strings_substr(entry, 0, n)
        if name != "." {
            if name != ".." {
                set child = fs::path::join(rel, name)
                set ok = fs_remove_recursive(root, child)
                if !ok {
                    pal_dir_close(d)
                    return false
                }
            }
        }
        set n = pal_dir_next_name(d, entry, 256)
    }
    pal_dir_close(d)
    return pal_root_remove(root, rel)
}

// Remove a single entry (file, symlink, or empty directory). A symlink is
// unlinked — never followed — even when it points outside the path's parent.
// Returns false and leaves fs::last_error() set to the PAL error code
// (PAL_ERR_NOT_EMPTY for a non-empty directory).
pub fn remove: (path :&str) :bool {
    set root = pal_root_open(fs::path::dir(path))
    if root <= 0 {
        return false
    }
    set ok = pal_root_remove(root, fs::path::name(path))
    pal_root_close(root)
    return ok
}

// Recursively remove a file, symlink, or directory tree. Intermediate and
// trailing symlinks are never followed (the sandbox rejects them); a symlink
// inside the tree is deleted without entering its target.
pub fn remove_all: (path :&str) :bool {
    set root = pal_root_open(fs::path::dir(path))
    if root <= 0 {
        return false
    }
    set ok = fs_remove_recursive(root, fs::path::name(path))
    pal_root_close(root)
    return ok
}

// Last PAL error code from a failed fs operation (see PAL_ERR_* above).
// Read immediately after a failed call; 0 (PAL_ERR_OK) means no error.
pub fn last_error: () :i64 {
    return pal_last_error()
}

pub fn list: (path :&str) :vec[str] {
    set root = pal_root_open(".")
    set d = pal_dir_open(root, path)
    set result = [] :vec[str] mut
    set entry = strings::repeat("\0" 256) :str mut
    set n = pal_dir_next_name(d, entry, 256) :i64 mut
    while n > 0 {
        set name = rt_strings_substr(entry, 0, n)
        set result = rt_vecs_push_ptr(result, name)
        set n = pal_dir_next_name(d, entry, 256)
    }
    pal_dir_close(d)
    pal_root_close(root)
    return result
}

pub fn mkdir: (path :&str) :bool {
    return pal_fs_mkdir(path)
}

// ── path ────────────────────────────────────────────────────────
pub fn path: () {
    pub fn join: (a :&str, b :&str) :&str {
        set last = rt_strings_char_at(a, len(a) - 1)
        if last == 47 {
            return rt_string_concat(a, b)
        } else {
            return rt_string_concat(rt_string_concat(a, "/"), b)
        }
    }

    pub fn dir: (path :&str) :&str {
        set i = len(path) - 1 :i64 mut
        while i > 0 {
            if rt_strings_char_at(path, i) == 47 {
                return rt_strings_substr(path, 0, i)
            }
            set i = i - 1
        }
        return "."
    }

    pub fn name: (path :&str) :&str {
        set i = len(path) - 1 :i64 mut
        while i > 0 {
            if rt_strings_char_at(path, i) == 47 {
                return rt_strings_substr(path, i + 1, len(path))
            }
            set i = i - 1
        }
        return path
    }

    pub fn ext: (path :&str) :&str {
        set n = fs::path::name(path)
        set i = len(n) - 1 :i64 mut
        while i > 0 {
            if rt_strings_char_at(n, i) == 46 {
                return rt_strings_substr(n, i, len(n))
            }
            set i = i - 1
        }
        return ""
    }
}

// ── dir ─────────────────────────────────────────────────────────
pub fn dir: () {
    pub fn create: (path :&str) :bool {
        return pal_fs_mkdir(path)
    }

    pub fn remove: (path :&str) :bool {
        return pal_fs_rmdir(path)
    }

    pub fn open: (root :Root, path :&str) :Dir {
        set h = pal_dir_open(root.handle, path)
        return (Dir handle: h)
    }

    pub fn next: (d :Dir, entry :&mut str) :bool {
        return pal_dir_next_name(d.handle, entry, 256) > 0
    }

    pub fn close: (d :Dir) {
        use pal_dir_close(d.handle)
    }
}

// ── root ────────────────────────────────────────────────────────
pub fn root: () {
    pub fn open: (path :&str) :Root {
        set h = pal_root_open(path)
        return (Root handle: h)
    }

    pub fn close: (root :Root) {
        use pal_root_close(root.handle)
    }
}

// ── file ────────────────────────────────────────────────────────
pub fn file: () {
    pub fn open: () {
        pub fn read: (root :Root, path :&str) :File {
            set h = pal_file_open(root.handle, path, 1 :i32)
            return (File handle: h)
        }

        pub fn write: (root :Root, path :&str) :File {
            set h = pal_file_open(root.handle, path, 2 :i32)
            return (File handle: h)
        }

        pub fn create: (root :Root, path :&str) :File {
            set h = pal_file_open(root.handle, path, 7 :i32)
            return (File handle: h)
        }

        pub fn truncate: (root :Root, path :&str) :File {
            set h = pal_file_open(root.handle, path, 15 :i32)
            return (File handle: h)
        }
    }

    pub fn read: (file :File, buf :&mut str, max_len :i64) :i64 {
        return pal_file_read(file.handle, buf, max_len)
    }

    pub fn write: (file :File, data :&str) :i64 {
        return pal_file_write(file.handle, data, len(data))
    }

    pub fn seek: (file :File, offset :i64, whence :i32) :i64 {
        return pal_file_seek(file.handle, offset, whence)
    }

    pub fn size: (file :File) :i64 {
        return pal_file_size(file.handle)
    }

    pub fn close: (file :File) {
        use pal_file_close(file.handle)
    }
}
