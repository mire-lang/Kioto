module proc

pub struct Process {
    handle :i64
}

extern fn pal_proc_create: (argv :ptr, flags :i32, stdin_ch :i64, stdout_ch :i64, stderr_ch :i64) :i64 lib "c"
extern fn pal_proc_wait: (proc :i64) :i64 lib "c"
extern fn pal_proc_kill: (proc :i64) :i64 lib "c"
extern fn pal_proc_close: (proc :i64) lib "c"
extern fn pal_proc_stdin: (proc :i64) :i64 lib "c"
extern fn pal_proc_stdout: (proc :i64) :i64 lib "c"
extern fn pal_proc_stderr: (proc :i64) :i64 lib "c"
extern fn rt_build_argv: (cmd :&str, args :vec[str]) :ptr lib "c"
extern fn rt_free_argv: (argv :ptr, argc :i64) lib "c"
extern fn rt_vec_len: (v :vec[str]) :i64 lib "c"
extern fn rt_proc_capture_argv: (cmd :&str, args :vec[str]) :str lib "c"
extern fn rt_proc_capture_argv2: (cmd :&str, args :vec[str], cwd :&str, merge_err :i64) :str lib "c"
extern fn rt_proc_last_exit: () :i64 lib "c"
extern fn rt_read_tty: () :str lib "c"

cons PAL_SPAWN_WAIT = 1 :i32

// ── run ─────────────────────────────────────────────────────────
// Launching variants. All argv-based (no shell anywhere): spawn = create +
// wait with exit code; output/output_cwd = capture stdout (optionally merged
// with stderr, optionally in a working directory); read_line reads the
// controlling terminal directly (no subprocess).
pub fn run: () {
    pub fn create: (cmd :&str, args :vec[str], flags :i32, stdin_ch :i64, stdout_ch :i64, stderr_ch :i64) :Process {
        set argv = rt_build_argv(cmd, args)
        set argc = rt_vec_len(args) + 1
        set h = pal_proc_create(argv, flags, stdin_ch, stdout_ch, stderr_ch)
        use rt_free_argv(argv, argc)
        return (Process handle: h)
    }

    pub fn spawn: (cmd :&str, args :vec[str]) :i64 {
        set argv = rt_build_argv(cmd, args)
        set argc = rt_vec_len(args) + 1
        set h = pal_proc_create(argv, 1 :i32, 0, 0, 0)
        use rt_free_argv(argv, argc)
        if h <= 0 { return -1 }
        set exit_code = pal_proc_wait(h)
        use pal_proc_close(h)
        return exit_code
    }

    pub fn output: (cmd :&str, args :vec[str]) :str {
        return rt_proc_capture_argv(cmd, args)
    }

    // Extended argv capture: run in `cwd` ("" = inherit current directory) and
    // optionally merge the child's stderr into the captured output (merge_err).
    pub fn output_cwd: (cmd :&str, args :vec[str], cwd :&str, merge_err :bool) :str {
        set flag = 0 :i64 mut
        if merge_err { set flag = 1 }
        return rt_proc_capture_argv2(cmd, args, cwd, flag)
    }

    // Exit code of the last argv capture (rt_proc_capture_argv / _argv2).
    // 0 = success, 127 = spawn failure, 126 = bad working directory.
    pub fn last_exit: () :i64 {
        return rt_proc_last_exit()
    }

    // Read one line from the controlling terminal (no shell, no subprocess).
    // Non-interactive contexts return "y" (safe default for Y/n prompts).
    pub fn read_line: () :str {
        return rt_read_tty()
    }
}

// ── process ─────────────────────────────────────────────────────
pub fn wait: (p :Process) :i64 {
    return pal_proc_wait(p.handle)
}

pub fn kill: (p :Process) :bool {
    return pal_proc_kill(p.handle) != 0
}

pub fn close: (p :Process) {
    use pal_proc_close(p.handle)
}

// ── stream ──────────────────────────────────────────────────────
pub fn stream: () {
    pub fn input: (p :Process) :i64 {
        return pal_proc_stdin(p.handle)
    }

    pub fn output: (p :Process) :i64 {
        return pal_proc_stdout(p.handle)
    }

    pub fn error: (p :Process) :i64 {
        return pal_proc_stderr(p.handle)
    }
}
