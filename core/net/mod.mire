module net
// Network PAL bindings
load kioto::net::_externs

pub struct Socket {
    handle :i64
}

pub struct Listener {
    handle :i64
}

// Socket type constants (inlined to avoid module loading issues)
cons PAL_SOCKET_TCP = 1 :i32
cons PAL_SOCKET_UDP = 2 :i32

// ── socket ──────────────────────────────────────────────────────
pub fn socket: () {
    pub fn connect: () {
        pub fn tcp: (host :&str, port :u16) :Socket {
            set h = pal_socket_connect(host, port, PAL_SOCKET_TCP)
            return (Socket handle: h)
        }

        pub fn udp: (host :&str, port :u16) :Socket {
            set h = pal_socket_connect(host, port, PAL_SOCKET_UDP)
            return (Socket handle: h)
        }
    }

    pub fn send: (sock :&Socket, data :&str) :i64 {
        return pal_socket_send(sock.handle, data, len(data))
    }

    pub fn recv: (sock :&Socket, buf :&mut str, max_len :i64) :i64 {
        return pal_socket_recv(sock.handle, buf, max_len)
    }

    pub fn close: (sock :&Socket) {
        use pal_socket_close(sock.handle)
    }
}

// ── listener ────────────────────────────────────────────────────
pub fn listener: () {
    pub fn bind: () {
        pub fn tcp: (port :u16) :Listener {
            set h = pal_listener_bind(port PAL_SOCKET_TCP)
            return (Listener handle: h)
        }

        pub fn udp: (port :u16) :Listener {
            set h = pal_listener_bind(port PAL_SOCKET_UDP)
            return (Listener handle: h)
        }
    }

    pub fn accept: (listener :&Listener) :Socket {
        set h = pal_listener_accept(listener.handle)
        return (Socket handle: h)
    }

    pub fn send: (listener :&Listener, data :&str) :i64 {
        return pal_listener_send(listener.handle data len(data))
    }

    pub fn recv: (listener :&Listener, buf :&mut str, max_len :i64) :i64 {
        return pal_listener_recv(listener.handle buf max_len)
    }

    pub fn close: (listener :Listener) {
        use pal_listener_close(listener.handle)
    }
}
