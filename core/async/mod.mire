module async

pub struct Channel {
    handle :i64
}

extern fn pal_channel_create: () :i64 lib "c"
extern fn pal_channel_send: (ch :i64, data :&str, len :i64) :i64 lib "c"
extern fn pal_channel_close: (ch :i64) lib "c"
extern fn rt_channel_recv_into: (ch :i64, buf :&mut str, cap :i64) :i64 lib "c"

extern fn pal_proc_create: (argv :ptr, flags :i32, stdin_ch :i64, stdout_ch :i64, stderr_ch :i64) :i64 lib "c"
extern fn pal_proc_wait: (proc :i64) :i64 lib "c"
extern fn rt_build_argv: (cmd :&str, args :vec[str]) :ptr lib "c"
extern fn rt_free_argv: (argv :ptr, argc :i64) lib "c"

pub struct Task {
    value :str
}

// ── task ────────────────────────────────────────────────────────
pub fn task: () {
    pub fn ready: (value :str) :Task {
        return (Task value: value)
    }

    pub fn value: (t :Task, fallback :str) :str {
        return t.value
    }
}

// ── channel ─────────────────────────────────────────────────────
pub fn channel: () {
    pub fn create: () :Channel {
        set h = pal_channel_create()
        return (Channel handle: h)
    }

    pub fn send: (ch :&Channel, data :&str) :i64 {
        return pal_channel_send(ch.handle, data, len(data))
    }

    pub fn recv: (ch :&Channel, buf :&mut str, cap :i64) :i64 {
        return rt_channel_recv_into(ch.handle, buf, cap)
    }

    pub fn close: (ch :&Channel) {
        use pal_channel_close(ch.handle)
    }
}

// ── process ─────────────────────────────────────────────────────
pub fn spawn: (cmd :&str) :i64 {
    set argv = rt_build_argv(cmd, [] :vec[str])
    set h = pal_proc_create(argv, 0 :i32, 0, 0, 0)
    use rt_free_argv(argv, 1)
    return h
}

pub fn wait: (pid :i64) :i64 {
    return pal_proc_wait(pid)
}
