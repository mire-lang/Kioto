module _externs
// Single source of truth — all math submodules import this

// Constants
extern fn rt_math_pi: () :f64 lib "c"
extern fn rt_math_e: () :f64 lib "c"
extern fn rt_math_tau: () :f64 lib "c"
extern fn rt_math_inf: () :f64 lib "c"
extern fn rt_math_neg_inf: () :f64 lib "c"
extern fn rt_math_nan: () :f64 lib "c"
extern fn rt_math_epsilon: () :f64 lib "c"

// Number-theoretic functions
extern fn rt_math_comb: (n :i64, k :i64) :i64 lib "c"
extern fn rt_math_factorial: (n :i64) :i64 lib "c"
extern fn rt_math_gcd: (a :i64, b :i64) :i64 lib "c"
extern fn rt_math_isqrt: (n :i64) :i64 lib "c"
extern fn rt_math_lcm: (a :i64, b :i64) :i64 lib "c"
extern fn rt_math_perm: (n :i64, k :i64) :i64 lib "c"

// Float manipulation
extern fn rt_math_ceil: (value :f64) :i64 lib "c"
extern fn rt_math_floor: (value :f64) :i64 lib "c"
extern fn rt_math_round: (value :f64) :i64 lib "c"
extern fn rt_math_trunc: (value :f64) :i64 lib "c"
extern fn rt_math_fabs: (value :f64) :f64 lib "c"
extern fn rt_math_fmod: (x :f64, y :f64) :f64 lib "c"
extern fn rt_math_remainder: (x :f64, y :f64) :f64 lib "c"
extern fn rt_math_fma: (x :f64, y :f64, z :f64) :f64 lib "c"
extern fn rt_math_copysign: (x :f64, y :f64) :f64 lib "c"
extern fn rt_math_frexp: (value :f64, exponent :ptr) :f64 lib "c"
extern fn rt_math_ldexp: (value :f64, i :i64) :f64 lib "c"
extern fn rt_math_nextafter: (x :f64, y :f64, steps :i64) :f64 lib "c"
extern fn rt_math_ulp: (value :f64) :f64 lib "c"
extern fn rt_math_modf: (value :f64, iptr :ptr) :f64 lib "c"

// Float classification
extern fn rt_math_isfinite: (value :f64) :bool lib "c"
extern fn rt_math_isinf: (value :f64) :bool lib "c"
extern fn rt_math_isnan: (value :f64) :bool lib "c"
extern fn rt_math_isclose: (a :f64, b :f64, rel_tol :f64, abs_tol :f64) :bool lib "c"

// Power, exponential and logarithmic
extern fn rt_math_sqrt: (value :f64) :f64 lib "c"
extern fn rt_math_cbrt: (value :f64) :f64 lib "c"
extern fn rt_math_pow: (base :f64, exponent :f64) :f64 lib "c"
extern fn rt_math_exp: (value :f64) :f64 lib "c"
extern fn rt_math_exp2: (value :f64) :f64 lib "c"
extern fn rt_math_expm1: (value :f64) :f64 lib "c"
extern fn rt_math_log: (value :f64) :f64 lib "c"
extern fn rt_math_log2: (value :f64) :f64 lib "c"
extern fn rt_math_log10: (value :f64) :f64 lib "c"
extern fn rt_math_log1p: (value :f64) :f64 lib "c"

// Trigonometric
extern fn rt_math_sin: (value :f64) :f64 lib "c"
extern fn rt_math_cos: (value :f64) :f64 lib "c"
extern fn rt_math_tan: (value :f64) :f64 lib "c"
extern fn rt_math_asin: (value :f64) :f64 lib "c"
extern fn rt_math_acos: (value :f64) :f64 lib "c"
extern fn rt_math_atan: (value :f64) :f64 lib "c"
extern fn rt_math_atan2: (y :f64, x :f64) :f64 lib "c"

// Hyperbolic
extern fn rt_math_sinh: (value :f64) :f64 lib "c"
extern fn rt_math_cosh: (value :f64) :f64 lib "c"
extern fn rt_math_tanh: (value :f64) :f64 lib "c"
extern fn rt_math_asinh: (value :f64) :f64 lib "c"
extern fn rt_math_acosh: (value :f64) :f64 lib "c"
extern fn rt_math_atanh: (value :f64) :f64 lib "c"

// Special functions
extern fn rt_math_erf: (value :f64) :f64 lib "c"
extern fn rt_math_erfc: (value :f64) :f64 lib "c"
extern fn rt_math_gamma: (value :f64) :f64 lib "c"
extern fn rt_math_lgamma: (value :f64) :f64 lib "c"

// Angular conversion
extern fn rt_math_degrees: (value :f64) :f64 lib "c"
extern fn rt_math_radians: (value :f64) :f64 lib "c"

// Summation and product
extern fn rt_math_fsum: (list :&vec[f64]) :f64 lib "c"
extern fn rt_math_prod: (list :&vec[f64], start :f64) :f64 lib "c"
extern fn rt_math_sumprod: (p :&vec[f64], q :&vec[f64]) :f64 lib "c"
extern fn rt_math_dist: (p :&vec[f64], q :&vec[f64]) :f64 lib "c"
extern fn rt_math_hypot: (x :f64, y :f64) :f64 lib "c"

// Random
extern fn rt_math_random_seed: (seed :i64) lib "c"
extern fn rt_math_random_u64: () :i64 lib "c"
extern fn rt_math_random_i64: () :i64 lib "c"
extern fn rt_math_random_f64: () :f64 lib "c"
extern fn rt_math_random_bool: () :bool lib "c"
extern fn rt_math_random_range_i64: (min :i64, max :i64) :i64 lib "c"

// Statistics (existing i64-based)
extern fn rt_math_sum_i64: (list :&vec[i64]) :i64 lib "c"
extern fn rt_math_min_list_i64: (list :&vec[i64]) :i64 lib "c"
extern fn rt_math_max_list_i64: (list :&vec[i64]) :i64 lib "c"
extern fn rt_math_mean_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_variance_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_stddev_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_median_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_range_i64: (end :i64) :vec[i64] lib "c"
extern fn rt_math_range_between_i64: (start :i64, end :i64) :vec[i64] lib "c"
extern fn rt_math_range_step_i64: (start :i64, end :i64, step :i64) :vec[i64] lib "c"

// String operations (decimal arithmetic)
extern fn rt_string_to_i64: (value :str) :i64 lib "c"
extern fn rt_strings_len: (s :&str) :i64 lib "c"
extern fn rt_strings_strip: (s :&str) :str lib "c"
extern fn rt_strings_starts_with: (s :&str, prefix :&str) :bool lib "c"
extern fn rt_strings_substr: (s :&str, start :i64, len :i64) :str lib "c"
extern fn rt_strings_index_of: (s :&str, sub :&str) :i64 lib "c"
extern fn rt_strings_pad_left: (s :&str, w :i64, pad :&str) :str lib "c"