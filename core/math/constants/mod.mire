module constants
load kioto::math::_externs

pub fn pi: () :f64 { return rt_math_pi() }
pub fn e: () :f64 { return rt_math_e() }
pub fn tau: () :f64 { return rt_math_tau() }
pub fn inf: () :f64 { return rt_math_inf() }
pub fn neg_inf: () :f64 { return rt_math_neg_inf() }
pub fn nan: () :f64 { return rt_math_nan() }
pub fn epsilon: () :f64 { return rt_math_epsilon() }