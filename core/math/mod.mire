module math
load kioto::math::constants
load kioto::math::number_theoretic
load kioto::math::float
load kioto::math::float_manip
load kioto::math::power
load kioto::math::sum
load kioto::math::angle
load kioto::math::trig
load kioto::math::hyperbolic
load kioto::math::special

// Re-exports for flat API access (from submodules)
pub fn round: (value :f64) :i64 { return float::round(value) }
pub fn abs: (n :i64) :i64 { return number_theoretic::abs(n) }
pub fn min: (a :i64, b :i64) :i64 { return number_theoretic::min(a, b) }
pub fn max: (a :i64, b :i64) :i64 { return number_theoretic::max(a, b) }
pub fn clamp: (n :i64, min :i64, max :i64) :i64 {
    if n < min { return min }
    if n > max { return max }
    return n
}
pub fn range: (end :i64) :vec[i64] { return number_theoretic::range(end) }
pub fn between: (start :i64, end :i64) :vec[i64] { return number_theoretic::between(start, end) }
pub fn step: (start :i64, end :i64, n :i64) :vec[i64] { return number_theoretic::step(start, end, n) }
pub fn sum: (list :&vec[i64]) :i64 { return sum::sum_i64(list) }
pub fn mean: (list :&vec[i64]) :f64 { return sum::mean(list) }
pub fn variance: (list :&vec[i64]) :f64 { return sum::variance(list) }
pub fn stddev: (list :&vec[i64]) :f64 { return sum::stddev(list) }
pub fn median: (list :&vec[i64]) :f64 { return sum::median(list) }
pub fn minlist: (list :&vec[i64]) :i64 { return sum::minlist(list) }
pub fn maxlist: (list :&vec[i64]) :i64 { return sum::maxlist(list) }

// Complex numbers, decimal arithmetic, random — kept as structured modules
load kioto::math::complex
load kioto::math::decimal
load kioto::math::random