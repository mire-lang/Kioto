module float_manip
load kioto::math::_externs

struct FrexpResult {
    mantissa :f64
    exponent :i64
}

struct ModfResult {
    fractional :f64
    integer :f64
}

pub fn isfinite: (value :f64) :bool { return rt_math_isfinite(value) }
pub fn isinf: (value :f64) :bool { return rt_math_isinf(value) }
pub fn isnan: (value :f64) :bool { return rt_math_isnan(value) }
pub fn isclose: (a :f64, b :f64, rel_tol :f64, abs_tol :f64) :bool { return rt_math_isclose(a, b, rel_tol, abs_tol) }
pub fn copysign: (x :f64, y :f64) :f64 { return rt_math_copysign(x, y) }
pub fn frexp: (value :f64) :FrexpResult {
    set exp = 0 :i64 mut
    set mantissa = rt_math_frexp(value, &exp)
    return (FrexpResult mantissa: mantissa, exponent: exp)
}
pub fn ldexp: (value :f64, i :i64) :f64 { return rt_math_ldexp(value, i) }
pub fn nextafter: (x :f64, y :f64, steps :i64) :f64 { return rt_math_nextafter(x, y, steps) }
pub fn ulp: (value :f64) :f64 { return rt_math_ulp(value) }
pub fn modf: (value :f64) :ModfResult {
    set intpart = 0.0 :f64 mut
    set frac = rt_math_modf(value, &intpart)
    return (ModfResult fractional: frac, integer: intpart)
}