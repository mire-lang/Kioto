module stats
load kioto::math::_externs

pub fn sum: (list :&vec[i64]) :i64 { return rt_math_sum_i64(list) }
pub fn mean: (list :&vec[i64]) :f64 { return rt_math_mean_i64(list) }
pub fn avg: (list :&vec[i64]) :f64 { return rt_math_mean_i64(list) }
pub fn variance: (list :&vec[i64]) :f64 { return rt_math_variance_i64(list) }
pub fn stddev: (list :&vec[i64]) :f64 { return rt_math_stddev_i64(list) }
pub fn minlist: (list :&vec[i64]) :i64 { return rt_math_min_list_i64(list) }
pub fn maxlist: (list :&vec[i64]) :i64 { return rt_math_max_list_i64(list) }
pub fn median: (list :&vec[i64]) :f64 { return rt_math_median_i64(list) }

pub fn range: (end :i64) :vec[i64] { return rt_math_range_i64(end) }
pub fn between: (start :i64, end :i64) :vec[i64] { return rt_math_range_between_i64(start, end) }
pub fn step: (start :i64, end :i64, n :i64) :vec[i64] { return rt_math_range_step_i64(start, end, n) }
