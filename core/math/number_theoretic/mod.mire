module number_theoretic
load kioto::math::_externs

pub fn comb: (n :i64, k :i64) :i64 { return rt_math_comb(n, k) }
pub fn factorial: (n :i64) :i64 { return rt_math_factorial(n) }
pub fn gcd: (a :i64, b :i64) :i64 { return rt_math_gcd(a, b) }
pub fn isqrt: (n :i64) :i64 { return rt_math_isqrt(n) }
pub fn lcm: (a :i64, b :i64) :i64 { return rt_math_lcm(a, b) }
pub fn perm: (n :i64, k :i64) :i64 { return rt_math_perm(n, k) }

pub fn abs: (n :i64) :i64 { if n < 0 { return 0 - n } return n }
pub fn min: (a :i64, b :i64) :i64 { if a < b { return a } return b }
pub fn max: (a :i64, b :i64) :i64 { if a > b { return a } return b }
pub fn range: (end :i64) :vec[i64] { return rt_math_range_i64(end) }
pub fn between: (start :i64, end :i64) :vec[i64] { return rt_math_range_between_i64(start, end) }
pub fn step: (start :i64, end :i64, n :i64) :vec[i64] { return rt_math_range_step_i64(start, end, n) }