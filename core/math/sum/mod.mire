module sum
load kioto::math::_externs

pub fn hypot: (x :f64, y :f64) :f64 { return rt_math_hypot(x, y) }
pub fn fsum: (list :&vec[f64]) :f64 { return rt_math_fsum(list) }
pub fn prod: (list :&vec[f64], start :f64) :f64 { return rt_math_prod(list, start) }
pub fn sumprod: (p :&vec[f64], q :&vec[f64]) :f64 { return rt_math_sumprod(p, q) }
pub fn dist: (p :&vec[f64], q :&vec[f64]) :f64 { return rt_math_dist(p, q) }

// Statistics (from old stats module)
pub fn sum_i64: (list :&vec[i64]) :i64 { return rt_math_sum_i64(list) }
pub fn mean: (list :&vec[i64]) :f64 { return rt_math_mean_i64(list) }
pub fn variance: (list :&vec[i64]) :f64 { return rt_math_variance_i64(list) }
pub fn stddev: (list :&vec[i64]) :f64 { return rt_math_stddev_i64(list) }
pub fn median: (list :&vec[i64]) :f64 { return rt_math_median_i64(list) }
pub fn minlist: (list :&vec[i64]) :i64 { return rt_math_min_list_i64(list) }
pub fn maxlist: (list :&vec[i64]) :i64 { return rt_math_max_list_i64(list) }