module _externs
// Async C runtime and PAL

extern fn pal_channel_create: () :i64 lib "c"
extern fn pal_channel_send: (ch :i64, data :&str, len :i64) :i64 lib "c"
extern fn pal_channel_close: (ch :i64) lib "c"
extern fn rt_channel_recv_into: (ch :i64, buf :&mut str, cap :i64) :i64 lib "c"
extern fn pal_proc_create: (argv :ptr, flags :i32, stdin_ch :i64, stdout_ch :i64, stderr_ch :i64) :i64 lib "c"
extern fn pal_proc_wait: (proc :i64) :i64 lib "c"
extern fn rt_build_argv: (cmd :&str, args :vec[str]) :ptr lib "c"
extern fn rt_free_argv: (argv :ptr, argc :i64) lib "c"
