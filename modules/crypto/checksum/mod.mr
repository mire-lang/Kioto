module checksum

load kioto::fs
load kioto::strings
load mire::vec

extern fn rt_crypto_sha512_file_hex: (path :&str) :str lib "c"
extern fn rt_crypto_sha512_hex: (s :&str) :str lib "c"

// ── Checksums ───────────────────────────────────────────────────────────────
// SHA-512 is the strongest hash the runtime exposes; the heavy lifting lives
// in the libsodium binding (the rt_crypto_sha512_file_hex extern is
// binary-safe). Stores keep their digests as `key = <hex>` lines so Owl can
// verify installed packages without shelling out to sha512sum/base64.

/! Lowercase-hex SHA-512 of a file's raw bytes (binary-safe). !/
pub fn file: (path :&str) :str {
    return rt_crypto_sha512_file_hex(path)
}

/! Lowercase-hex SHA-512 of an in-memory string. !/
pub fn text: (s :&str) :str {
    return rt_crypto_sha512_hex(s)
}

/! Reads the value stored under `key` from a `key = value` checksum store.
   Returns "" when the file or the key is missing. !/
pub fn store_get: (store_path :&str, key :&str) :str {
    if !fs::exists(store_path) { return "" }
    set content = fs::read(store_path)
    set lines = strings::split(content "\n")
    set count = vec::len(lines)
    set prefix = strings::concat(key " = ")
    set plen = strings::len(prefix)
    set i = 0 :i64 mut
    while i < count {
        set line = vec::get::str(lines i)
        if strings::starts::with(line prefix) {
            return strings::substr(line plen 9999)
        }
        set i = i + 1
    }
    return ""
}

/! Inserts or replaces `key = value` in a checksum store, preserving the other
   entries. Returns true when the store was written. !/
pub fn store_put: (store_path :&str, key :&str, value :&str) :bool {
    set prefix = strings::concat(key " = ")
    set entry = strings::concat(prefix value)
    set nl = "\n"
    set out = "" :str mut
    set found = false :bool mut
    if fs::exists(store_path) {
        set content = fs::read(store_path)
        set lines = strings::split(content "\n")
        set count = vec::len(lines)
        set i = 0 :i64 mut
        while i < count {
            set line = vec::get::str(lines i)
            if strings::starts::with(line prefix) {
                set out = strings::concat(strings::concat(out entry) nl)
                set found = true
            } else {
                if i < count - 1 || strings::len(line) > 0 {
                    set out = strings::concat(strings::concat(out line) nl)
                }
            }
            set i = i + 1
        }
    }
    if !found { set out = strings::concat(strings::concat(out entry) nl) }
    fs::write(store_path out)
    return true
}

/! True when the stored digest for `key` matches `expected`. !/
pub fn verify: (store_path :&str, key :&str, expected :&str) :bool {
    set stored = checksum::store_get(store_path key)
    if stored == "" || expected == "" { return false }
    return stored == expected
}
