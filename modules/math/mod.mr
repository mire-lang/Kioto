// Kioto 3.0.0 — math quick tier.
//
// Scalar f64 helpers (abs, sign, min, max, clamp, floor, ceil, round, trunc)
// plus the list reductions (sum, avg, product, minlist, maxlist).
//
// Everything here is computed in Mire itself. There is no rt_math_* extern and
// no math.c in the link, so the module works in a runtime = "none" build.
//
// The list reductions take vec[i64] and return f64 because the standard
// library has no f64 element support: vec::get only exists for i64 and str.
// That matches 2.x, where sum_i64/mean/minlist/maxlist were i64-based and only
// fsum/prod were genuinely f64 (via rt_math_fsum). Restoring the f64
// collections means teaching mire::vec about f64 first.
//
// Rounding is done by greedy decomposition over the powers of two rather than
// by masking mantissa bits. Masking only works while |x| < 1: at that point the
// integer part still lives in the low mantissa bits, so clearing all 52 of them
// maps 3.75 to 2.0 instead of 3.0. Decomposition costs 52 iterations, which is
// the right trade for a tier whose job is to be correct and dependency-free.

load mire::vec
load kioto::math::consts
load kioto::math::seq

// 2^52, the first magnitude at which every f64 is already an integer.
cons LIMIT = 4503599627370496.0 :f64
// Largest power of two below LIMIT.
cons TOP = 2251799813685248.0 :f64

// Absolute value. NaN compares false against 0 and so is returned unchanged.
pub fn abs: (x :f64) :f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

// -1.0, 0.0 or 1.0. NaN has no sign, so it reports 0.0.
pub fn sign: (x :f64) :f64 {
    if x != x {
        return 0.0
    }
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return 0.0 - 1.0
    }
    return 0.0
}

pub fn min: (a :f64, b :f64) :f64 {
    if a < b {
        return a
    }
    return b
}

pub fn max: (a :f64, b :f64) :f64 {
    if a > b {
        return a
    }
    return b
}

// Constrain x to [lo, hi]. A reversed range collapses to hi, matching the
// behaviour of clamping against an inverted pair.
pub fn clamp: (x :f64, lo :f64, hi :f64) :f64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// Drop the fractional part, rounding toward zero.
pub fn trunc: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set neg = x < 0.0
    set a = if neg { 0.0 - x } else { x } :f64 mut
    if a < 1.0 {
        // |x| below 1 has no integer part, so the answer is zero for either
        // sign. Returning x here would hand back -0.75 unchanged.
        return 0.0
    }
    set t = 0.0 :f64 mut
    set p = 2251799813685248.0 :f64 mut
    while p >= 1.0 {
        if a >= p {
            set a -= p
            set t += p
        }
        set p *= 0.5
    }
    if neg {
        return 0.0 - t
    }
    return t
}

// Largest integer not greater than x.
pub fn floor: (x :f64) :f64 {
    set t = trunc(x)
    if t == x {
        return t
    }
    if x < 0.0 {
        return t - 1.0
    }
    return t
}

// Smallest integer not less than x.
pub fn ceil: (x :f64) :f64 {
    set t = trunc(x)
    if t == x {
        return t
    }
    if x > 0.0 {
        return t + 1.0
    }
    return t
}

// Nearest integer, halves away from zero (round(2.5) = 3, round(-2.5) = -3).
pub fn round: (x :f64) :f64 {
    set t = trunc(x)
    if t == x {
        return t
    }
    set d = x - t
    if d >= 0.5 {
        return t + 1.0
    }
    if d <= 0.0 - 0.5 {
        return t - 1.0
    }
    return t
}

// Sum of the elements, accumulated in f64.
pub fn sum: (list :&vec[i64]) :f64 {
    set acc = 0.0 :f64 mut
    set i = 0 :i64 mut
    while i < vec::len(list) {
        set acc += vec::get::i64(list i)
        set i += 1
    }
    return acc
}

// Arithmetic mean. An empty list has no mean, so it reports 0.0.
pub fn avg: (list :&vec[i64]) :f64 {
    set n = vec::len(list)
    if n == 0 {
        return 0.0
    }
    return sum(list) / n
}

// Product of the elements. An empty list is the multiplicative identity.
pub fn product: (list :&vec[i64]) :f64 {
    set acc = 1.0 :f64 mut
    set i = 0 :i64 mut
    while i < vec::len(list) {
        set acc *= vec::get::i64(list i)
        set i += 1
    }
    return acc
}

// Smallest element, or 0 for an empty list.
pub fn minlist: (list :&vec[i64]) :i64 {
    if vec::len(list) == 0 {
        return 0
    }
    set best = vec::get::i64(list 0) :i64 mut
    set i = 1 :i64 mut
    while i < vec::len(list) {
        set v = vec::get::i64(list i)
        if v < best {
            set best = v
        }
        set i += 1
    }
    return best
}

// Largest element, or 0 for an empty list.
pub fn maxlist: (list :&vec[i64]) :i64 {
    if vec::len(list) == 0 {
        return 0
    }
    set best = vec::get::i64(list 0) :i64 mut
    set i = 1 :i64 mut
    while i < vec::len(list) {
        set v = vec::get::i64(list i)
        if v > best {
            set best = v
        }
        set i += 1
    }
    return best
}

// True when |x| is small enough for the power-of-two decomposition to be
// exact, which is every finite f64 below 2^52. NaN and the infinities fail
// here, which is what makes trunc/floor/ceil/round hand them back untouched.
fn integral_magnitude: (x :f64) :bool {
    if x != x {
        return false
    }
    return abs(x) < 4503599627370496.0
}
