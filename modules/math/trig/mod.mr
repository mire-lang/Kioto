module trig

// Kioto 3.0.0 — math::trig
//
// Pure-Mire implementations of the elementary transcendental functions.
// No rt_math_* extern; everything is built from the quick tier, math::power
// and math::consts.  The algorithms are deliberately simple: argument
// reduction to a small interval followed by a minimax polynomial.  They are
// accurate enough for the 1e-12 tolerances used in the test suite.

load kioto::math::consts
load kioto::math::power

// ── local float helpers (avoid namespace resolution issues) ───
fn trunc_impl: (x :f64) :f64 {
    if x != x { return x } // NaN
    if x < 1.0 && x > -1.0 { return 0.0 }
    set neg = x < 0.0
    set a = if neg { 0.0 - x } else { x } :f64 mut
    if a < 1.0 { return 0.0 }
    set t = 0.0 :f64 mut
    set p = 2251799813685248.0 :f64 mut
    while p >= 1.0 {
        if a >= p {
            set a = a - p
            set t = t + p
        }
        set p = p * 0.5
    }
    if neg { return 0.0 - t }
    return t
}

fn floor_impl: (x :f64) :f64 {
    if x != x { return x } // NaN
    set t = trunc_impl(x)
    if t == x { return t }
    if x < 0.0 { return t - 1.0 }
    return t
}

fn round_impl: (x :f64) :f64 {
    if x != x { return x } // NaN
    set t = trunc_impl(x)
    if t == x { return t }
    set d = x - t
    if d >= 0.5 { return t + 1.0 }
    if d <= 0.0 - 0.5 { return t - 1.0 }
    return t
}

// ── constants ──────────────────────────────────────────────────────
fn two_pi: () :f64 { return 2.0 * consts::pi() }
fn half_pi: () :f64 { return consts::pi() / 2.0 }

// ── helpers ────────────────────────────────────────────────────────
// Reduce x to [-π, π] using fmod via floor.
fn reduce_2pi: (x :f64) :f64 {
    set tp = two_pi()
    set k = floor_impl(x / tp)
    return x - k * tp
}

// Reduce to [-π/4, π/4] for sin/cos using the identity sin(x) = ±sin(r), cos(x)=±cos(r)
// where r = x - n*π/2, n = round(x/(π/2)).
fn reduce_pi4: (x :f64) :f64 {
    set hp = half_pi()
    set n = round_impl(x / hp)
    return x - n * hp
}

// sin via Taylor series up to x^13 (sufficient for |x| ≤ π/4)
fn sin_small: (x :f64) :f64 {
    set x2 = x * x
    // coefficients for sin(x) = x - x^3/3! + x^5/5! - x^7/7! + x^9/9! - x^11/11! + x^13/13!
    set t1 = x
    set t3 = t1 * x2 / 6.0
    set t5 = t3 * x2 / 20.0
    set t7 = t5 * x2 / 42.0
    set t9 = t7 * x2 / 72.0
    set t11 = t9 * x2 / 110.0
    set t13 = t11 * x2 / 156.0
    return t1 - t3 + t5 - t7 + t9 - t11 + t13
}

// cos via Taylor series up to x^12
fn cos_small: (x :f64) :f64 {
    set x2 = x * x
    // cos(x) = 1 - x^2/2! + x^4/4! - x^6/6! + x^8/8! - x^10/10! + x^12/12!
    set t0 = 1.0
    set t2 = t0 * x2 / 2.0
    set t4 = t2 * x2 / 12.0
    set t6 = t4 * x2 / 30.0
    set t8 = t6 * x2 / 56.0
    set t10 = t8 * x2 / 90.0
    set t12 = t10 * x2 / 132.0
    return t0 - t2 + t4 - t6 + t8 - t10 + t12
}

// ── public API ─────────────────────────────────────────────────────
pub fn sin: (x :f64) :f64 {
    set r = reduce_pi4(x)
    // Determine quadrant sign using original reduction n
    set hp = half_pi()
    set n = round_impl(x / hp)
    // n mod 4 decides sign: 0:+sin, 1:+cos, 2:-sin, 3:-cos
    // We'll just compute sin(r) and cos(r) then combine.
    set s = sin_small(r)
    set c = cos_small(r)
    // Use n & 3
    set m = n - floor_impl(n / 4.0) * 4.0
    // m in [0,4)
    if m < 1.0 { return s }
    if m < 2.0 { return c }
    if m < 3.0 { return 0.0 - s }
    return 0.0 - c
}

pub fn cos: (x :f64) :f64 {
    set r = reduce_pi4(x)
    set hp = half_pi()
    set n = round_impl(x / hp)
    set s = sin_small(r)
    set c = cos_small(r)
    set m = n - floor_impl(n / 4.0) * 4.0
    if m < 1.0 { return c }
    if m < 2.0 { return 0.0 - s }
    if m < 3.0 { return 0.0 - c }
    return s
}

pub fn tan: (x :f64) :f64 {
    return sin(x) / cos(x)
}

// atan via Taylor series up to x^15 on [-1,1], using identity atan(x) = π/2 - atan(1/x) for |x|>1
// The Maclaurin series, valid and FAST only for |x| <= 1/sqrt(3).
//
// atan(x) = x - x^3/3 + x^5/5 - ...
//
// The ratio between consecutive terms is x^2, so the series converges at the rate
// of x^2 per term: at |x| = 1/sqrt(3) that is a third per term, and at |x| = 1 it
// is one, which does not converge at all in practice. Calling this at |x| = 1 is
// what made atan(1.0) return 0.7543 instead of 0.7854 — fifteen terms of a
// series that had barely started. Reduce the argument first; that is atan's job,
// not this function's.
fn atan_small: (x :f64) :f64 {
    set x2 = x * x
    set term = x :f64 mut
    set sum = term :f64 mut
    set n = 3 :i64 mut
    set sign = -1.0 :f64 mut
    /! Nineteen terms puts x^39/39 in the tail, below 1e-7 at the worst argument
        this is ever called with. !/
    while n <= 19 {
        set term = term * x2
        set sum += sign * term / n
        set n += 2
        set sign = 0.0 - sign
    }
    return sum
}

// 1/sqrt(3), the boundary of atan_small's fast region.
fn atan_limit: () :f64 { return 0.57735026918962576451 }

// The half-angle reduction, x -> x / (1 + sqrt(1 + x^2)).
//
// Each application halves the argument's angle, which is what guarantees the
// argument lands below 1/sqrt(3). Unlike the (x-1)/(x+1) shift, it also stays
// well conditioned for very large x, because the denominator grows with x rather
// than subtracting two nearly equal numbers.
fn atan_half_angle: (x :f64) :f64 {
    return x / (1.0 + power::sqrt(1.0 + x * x))
}

pub fn atan: (x :f64) :f64 {
    /! atan is odd, so the whole function only has to handle x >= 0. Handling the
        sign here rather than in each branch also means 1/x can never be a
        division by zero for the reflection below. !/
    if x < 0.0 {
        return 0.0 - atan(0.0 - x)
    }
    set limit = atan_limit()
    if x <= limit {
        return atan_small(x)
    }
    if x >= 1.0 {
        /! Large x: atan(x) = pi/2 - atan(1/x). This is the numerically good
            direction, since 1/x is small and the series is at its fastest. The
            x*x above would overflow to infinity for x beyond ~1e154, which is
            why this branch comes before the half-angle one. !/
        set t = 1.0 / x
        if t <= limit {
            return half_pi() - atan_small(t)
        }
        return half_pi() - 2.0 * atan_small(atan_half_angle(t))
    }
    /! limit < x < 1: one half-angle step is already past the limit, and the
        argument is small enough that no precision is lost. !/
    return 2.0 * atan_small(atan_half_angle(x))
}

pub fn atan2: (y :f64, x :f64) :f64 {
    if x > 0.0 { return atan(y / x) }
    if x < 0.0 {
        if y >= 0.0 { return atan(y / x) + consts::pi() }
        return atan(y / x) - consts::pi()
    }
    // x == 0
    if y > 0.0 { return half_pi() }
    if y < 0.0 { return 0.0 - half_pi() }
    return 0.0
}

pub fn asin: (x :f64) :f64 {
    // asin(x) = atan2(x, sqrt(1 - x*x))
    if x < -1.0 || x > 1.0 { return 0.0 / 0.0 } // NaN
    set s = power::sqrt(1.0 - x * x)
    return atan2(x, s)
}

pub fn acos: (x :f64) :f64 {
    if x < -1.0 || x > 1.0 { return 0.0 / 0.0 }
    return half_pi() - asin(x)
}

// degrees / radians conversion
pub fn degrees: (rad :f64) :f64 { return rad * 180.0 / consts::pi() }
pub fn radians: (deg :f64) :f64 { return deg * consts::pi() / 180.0 }