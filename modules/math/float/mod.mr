// Kioto 3.0.0 - math::float.
//
// Binary64 predicates and the rounding family, in pure Mire with no rt_math_*
// extern, so the module links in a runtime = "none" build.
//
// Public symbols (20):
//   abs sign min max copysign
//   trunc fract ceil floor round
//   isNan isInf isFinite isNormal isSubnormal integral_magnitude
//   toBits fromBits ulp epsilon
//
// NaN and the infinities are handled by IEEE-754 comparison rules rather than
// by any special value: x != x is the NaN test, and 1.0 / 0.0 is the infinity.
// The rounding family hands NaN and +/-Inf back untouched, which is what C's
// trunc/floor/ceil/round do and is why isFinite is worth having alongside them.
//
// The rounding is greedy decomposition over the powers of two rather than
// masking mantissa bits. Masking only works while |x| < 1: at that point the
// integer part still lives in the low mantissa bits, so clearing all 52 of them
// maps 3.75 to 2.0 instead of 3.0. Decomposition costs 52 iterations, which is
// the right trade for a tier whose job is to be correct and dependency-free.
//
// Two names in here are compiler builtins: abs, floor, ceil, round, sqrt and
// pow are rewritten to PAL externs when called bare, so the internal callers go
// through magnitude_f64 and the public ones are only reached as
// math::float::abs. See the note on magnitude_f64.

// The two powers of two this module needs are written as literals at their use
// sites rather than declared here as cons, and that is deliberate.
//
// A cons is not a dependable way to share a value inside a module. It is not
// readable through a dotted path — neither a consumer nor a sibling can resolve
// it, which is why math::consts ships its constants as pub fn — and
// reachable-import selection drops a module's cons whenever a consumer
// references only part of that module. The second one bites here directly:
// integral_magnitude, called on its own, failed to compile with "Unknown
// identifier 'LIMIT'" for a constant declared nine lines above it in this very
// file. The 91-test suite passed, because the other tests referenced enough of
// this module for the cons to survive selection.
//
// These two names were also declared a second time in the root tier, which
// breaks the migration rule of one constant per module with a unique name, so
// removing the duplicates is right on that count alone.
//
// 2^52, the first magnitude at which every f64 is already an integer, is the
// integral_magnitude gate. 2^51, the largest power of two below it, is where the
// greedy decomposition starts.

// NaN, spelled as the one expression that is guaranteed to produce it.
fn nan: () :f64 { return 0.0 / 0.0 }

// True when |x| is small enough for the power-of-two decomposition to be
// exact, which is every finite f64 below 2^52. NaN and the infinities fail
// here, and that is what makes the rounding family hand them back untouched.
//
// Public because it is the gate the rounding family is built on, and a caller
// implementing its own decomposition needs the same question answered the same
// way. mod.mr carries a private copy of this predicate: the root tier never
// calls into a submodule — it is the flat quick tier, self-contained on
// purpose — so sharing would mean breaking that. The two are meant to agree;
// change one and change the other.
pub fn integral_magnitude: (x :f64) :bool {
    if x != x {
        return false
    }
    return magnitude_f64(x) < 4503599627370496.0
}

// Magnitude of a value. abs, floor, ceil, round, sqrt and pow are compiler
// builtins, so a bare call to any of those names inside a module is rewritten
// to a PAL extern instead of reaching this module's own definition. The
// internal work therefore goes through magnitude_f64, and the public abs below
// is only ever reached namespaced as math::float::abs.
//
// The name carries the element type because a loaded module is flattened into
// one flat namespace: two submodules that both called a helper `magnitude`
// would collide, and the type checker resolves a bare call by name rather than
// by module, so the second one silently picked up the first one's signature.
// That is not hypothetical, math::int has the same helper.
fn magnitude_f64: (x :f64) :f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

// Absolute value. NaN compares false against 0 and so comes back unchanged.
pub fn abs: (x :f64) :f64 {
    return magnitude_f64(x)
}

// -1.0, 0.0 or 1.0. NaN has no sign, so it reports 0.0.
pub fn sign: (x :f64) :f64 {
    if x != x {
        return 0.0
    }
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return 0.0 - 1.0
    }
    return 0.0
}

// Minimum of two values. NaN propagates, matching IEEE minNum's quiet-NaN rule
// rather than silently picking a side.
pub fn min: (a :f64, b :f64) :f64 {
    if a != a {
        return a
    }
    if b != b {
        return b
    }
    if a < b {
        return a
    }
    return b
}

// Maximum of two values. NaN propagates.
pub fn max: (a :f64, b :f64) :f64 {
    if a != a {
        return a
    }
    if b != b {
        return b
    }
    if a > b {
        return a
    }
    return b
}

// |a| carrying the sign of b, so copysign(1.0, -0.0) is -1.0 and not 1.0.
pub fn copysign: (a :f64, b :f64) :f64 {
    set mag = magnitude_f64(a)
    if b < 0.0 {
        return 0.0 - mag
    }
    // -0.0 < 0.0 is false, so negative zero needs its own test. Dividing by it
    // yields -Inf, which is the only arithmetic that can read a zero's sign.
    if b == 0.0 {
        if (1.0 / b) < 0.0 {
            return 0.0 - mag
        }
    }
    return mag
}

// Drop the fractional part, rounding toward zero.
// Internal implementation to avoid conflict with compiler builtin.
fn trunc_impl: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set neg = x < 0.0
    set a = if neg { 0.0 - x } else { x } :f64 mut
    if a < 1.0 {
        return 0.0
    }
    set t = 0.0 :f64 mut
    set p = 2251799813685248.0 :f64 mut
    while p >= 1.0 {
        if a >= p {
            set a = a - p
            set t = t + p
        }
        set p = p * 0.5
    }
    if neg {
        return 0.0 - t
    }
    return t
}

// Truncate toward zero (f64).
pub fn trunc_f64: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set neg = x < 0.0
    set a = if neg { 0.0 - x } else { x } :f64 mut
    if a < 1.0 {
        return 0.0
    }
    set t = 0.0 :f64 mut
    set p = 2251799813685248.0 :f64 mut
    while p >= 1.0 {
        if a >= p {
            set a = a - p
            set t = t + p
        }
        set p = p * 0.5
    }
    if neg {
        return 0.0 - t
    }
    return t
}

// Fractional part, x - trunc(x). Keeps the sign of x, so fract(-2.5) is -0.5.
pub fn fract: (x :f64) :f64 {
    if !integral_magnitude(x) {
        // Outside the decomposition range the rounding family hands x back
        // unchanged, because x is already an integer. The fractional part of an
        // integer is zero, not the integer, so fract has to answer 0.0 here
        // rather than inherit that shortcut. NaN and the infinities keep their
        // own values, matching the rest of the family.
        if x != x {
            return x
        }
        if isInf(x) {
            return x
        }
        return 0.0
    }
    return x - trunc_f64(x)
}

// Smallest integer not less than x.
pub fn ceil_f64: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set t = trunc_f64(x)
    if t == x {
        return t
    }
    if x > 0.0 {
        return t + 1.0
    }
    return t
}

// Largest integer not greater than x.
pub fn floor_f64: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set t = trunc_f64(x)
    if t == x {
        return t
    }
    if x < 0.0 {
        return t - 1.0
    }
    return t
}

// Smallest integer not less than x.
pub fn ceil_f64: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set t = trunc_f64(x)
    if t == x {
        return t
    }
    if x > 0.0 {
        return t + 1.0
    }
    return t
}

// Nearest integer, halves away from zero: round(2.5) is 3, round(-2.5) is -3.
// This is not banker's rounding, and the difference is deliberate and
// observable at every .5.
pub fn round_f64: (x :f64) :f64 {
    if !integral_magnitude(x) {
        return x
    }
    set t = trunc_f64(x)
    if t == x {
        return t
    }
    set d = x - t
    if d >= 0.5 {
        return t + 1.0
    }
    if d <= 0.0 - 0.5 {
        return t - 1.0
    }
    return t
}

// Not a number. True for the only value that is not equal to itself, which is
// why the test is written as x != x and not as a comparison.
pub fn isNan: (x :f64) :bool {
    return x != x
}

// Infinite, of either sign. Comparing against 1.0/0.0 works because dividing
// by zero is the one operation IEEE 754 requires to produce an infinity.
pub fn isInf: (x :f64) :bool {
    return x == 1.0 / 0.0 || x == -1.0 / 0.0
}

// Neither NaN nor infinite: the question worth asking before a division.
pub fn isFinite: (x :f64) :bool {
    return !isNan(x) && !isInf(x)
}

// A normal number is finite, non-zero, and not subnormal: its magnitude is at
// least 2^-1022, so it carries a full 53 bits of precision.
pub fn isNormal: (x :f64) :bool {
    if !isFinite(x) {
        return false
    }
    if x == 0.0 {
        return false
    }
    return magnitude_f64(x) >= pow2(0 - 1022)
}

// Subnormal: finite, non-zero, and smaller than the smallest normal. The
// leading bits of the significand are zero, so precision degrades towards zero.
pub fn isSubnormal: (x :f64) :bool {
    if !isFinite(x) {
        return false
    }
    if x == 0.0 {
        return false
    }
    return magnitude_f64(x) < pow2(0 - 1022)
}

// Gap between x and its neighbour, 2^(e - 52) where e is the exponent of x.
// NaN reports NaN, the infinities report Inf, and 0.0 reports the smallest
// subnormal, which is the true gap there.
pub fn ulp: (x :f64) :f64 {
    if x != x {
        return nan()
    }
    if isInf(x) {
        return 1.0 / 0.0
    }
    set a = magnitude_f64(x) :f64 mut
    if a < pow2(0 - 1022) {
        // Subnormal, and zero itself: the spacing never grows.
        return pow2(0 - 1074)
    }
    // Walk a into [1, 2) and count how far it moved, which recovers the
    // exponent without a logarithm.
    set e = 0 :i64 mut
    while a >= 2.0 {
        set a = a * 0.5
        set e = e + 1
    }
    while a < 1.0 {
        set a = a * 2.0
        set e = e - 1
    }
    return pow2(e - 52)
}

// 2^k by repeated doubling, for k from -1074 to 971.
fn pow2: (k :i64) :f64 {
    if k >= 0 {
        set out = 1.0 :f64 mut
        set i = 0 :i64 mut
        while i < k {
            set out = out * 2.0
            set i = i + 1
        }
        return out
    }
    set out = 1.0 :f64 mut
    set i = 0 :i64 mut
    while i < 0 - k {
        set out = out * 0.5
        set i = i + 1
    }
    return out
}

// Raw IEEE-754 bit pattern of x, as the i64 that holds it. The inverse of
// fromBits, and exact for every input including NaN and the infinities,
// because it reinterprets rather than converts.
//
// This is the escape hatch from the arithmetic above: hashing a float,
// seeding a PRNG from one, or writing a float to a file byte-for-byte all need
// the bits, and going through the round trip would lose NaN payloads and turn
// -0.0 into 0.0.
pub fn toBits: (x :f64) :i64 {
    return bits::i64(x)
}

// The f64 whose bit pattern is b. Exact inverse of toBits.
pub fn fromBits: (b :i64) :f64 {
    return bits::f64(b)
}

// The machine epsilon, 2^-52: the smallest gap between 1.0 and the next
// representable double. Written in scientific notation because that is what the
// value is; the same number as math::consts::epsilon.
pub fn epsilon: () :f64 { return 2.220446049250313e-16 }

