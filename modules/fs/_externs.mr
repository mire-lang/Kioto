module _externs
// Filesystem C runtime and PAL

extern fn pal_root_open: (path :&str) :i64 lib "c"
extern fn pal_root_close: (root :i64) lib "c"
extern fn pal_file_open: (root :i64, path :&str, flags :i32) :i64 lib "c"
extern fn pal_file_read: (file :i64, buf :&str, len :i64) :i64 lib "c"
extern fn pal_file_write: (file :i64, data :&str, len :i64) :i64 lib "c"
extern fn pal_file_seek: (file :i64, offset :i64, whence :i32) :i64 lib "c"
extern fn pal_file_size: (file :i64) :i64 lib "c"
extern fn pal_file_close: (file :i64) lib "c"
extern fn pal_dir_open: (root :i64, path :&str) :i64 lib "c"
extern fn pal_dir_next_name: (dir :i64, out :&mut str, cap :i64) :i64 lib "c"
extern fn pal_dir_close: (dir :i64) lib "c"

extern fn pal_fs_exists: (path :&str) :bool lib "c"
extern fn pal_fs_mkdir: (path :&str) :bool lib "c"
extern fn pal_fs_rmdir: (path :&str) :bool lib "c"
extern fn pal_fs_unlink: (path :&str) :bool lib "c"
extern fn pal_fs_remove: (path :&str) :bool lib "c"
extern fn pal_fs_is_file: (path :&str) :bool lib "c"
extern fn pal_fs_chmod: (path :&str, mode :&str) :bool lib "c"
extern fn pal_root_remove: (root :i64, path :&str) :bool lib "c"
extern fn pal_last_error: () :i64 lib "c"

extern fn rt_fs_read_bytes: (path :&str) :str lib "c"
extern fn rt_vecs_push_ptr: (list :vec[str], value :str) :vec[str] lib "c"
extern fn rt_strings_char_at: (s :&str, i :i64) :i64 lib "c"
extern fn rt_strings_substr: (s :&str, start :i64, len :i64) :str lib "c"
extern fn rt_string_concat: (left :&str, right :&str) :str lib "c"
